# AI Gateway（/chat 与 /find 共用）
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=

# 腾讯云 API 密钥（/chat 的 web_search 工具用，走元宝搜索 TC3 签名鉴权）。
# 在 https://console.cloud.tencent.com/cam/capi 创建；需要账号已开通元宝搜索服务。
# ⚠️ 这对密钥等同于账号权限，只写进 EdgeOne 环境变量，绝不提交进仓库。
# 不配的话聊天页只能靠模型自己的知识 + 站内检索，web_search 会直接报错。
WSA_SECRET_ID=
WSA_SECRET_KEY=

# 聊天页图片上传（POST /api/chat-image/upload 的代理，token 只在服务端）
# IMAGE_BED_TOKEN 与后台 backend/src/admin/public/app.js 里用的是同一个图床 token；
# 不配的话上传接口返回 503「图片上传未配置」，前端提示后其余功能不受影响。
IMAGE_BED_TOKEN=
# 可选，默认 https://img-edgeone.acetaffy.mom/api/index.php
IMAGE_BED_ENDPOINT=

# 视觉能力（可选）。默认模型 @makers/deepseek-v4-flash 文档没声明多模态，
# 所以代码是「乐观发送 → 上游 400 → 降级纯文本 + notice」。
# 配了 IMAGE_BED_TOKEN 之后可以用 scripts/probe-vision.mjs 手动探测一下到底支不支持。
# AI_GATEWAY_VISION_MODEL=xxx   图片轮换到指定视觉模型
# AI_GATEWAY_VISION=1|0         强制认为支持 / 不支持（省掉一次必然失败的试探）
AI_GATEWAY_VISION_MODEL=
AI_GATEWAY_VISION=
