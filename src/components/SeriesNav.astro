---
import { Icon } from "astro-icon/components";
import type { SeriesInfo } from "@utils/series-utils";
import { getPostUrlBySlug, url } from "@utils/url-utils";

interface Props {
	series: SeriesInfo;
}

const { series } = Astro.props;

const percent = Math.round((series.current.index / series.total) * 100);
const overviewUrl = `${url("/series/")}#${series.slug}`;
---

<div class="card-base onload-animation mb-5 px-5 py-4 flex flex-col gap-3">
    <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-3 min-w-0">
            <div class="meta-icon !mr-0 shrink-0">
                <Icon name="material-symbols:library-books-outline-rounded" class="text-lg"></Icon>
            </div>
            <div class="min-w-0">
                <a href={overviewUrl}
                   class="block truncate font-bold text-90 transition hover:text-[var(--primary)]"
                   aria-label={series.name}>
                    {series.name}
                </a>
                <div class="mt-0.5 text-50 text-xs">
                    系列第 {series.current.index} / {series.total} 章
                </div>
            </div>
        </div>
        <a href={overviewUrl} class="btn-plain h-8 shrink-0 rounded-lg px-2.5 text-xs gap-1">
            系列总览
            <Icon name="material-symbols:chevron-right-rounded" class="text-base"></Icon>
        </a>
    </div>

    <!-- 阅读进度条：当前在第几章 -->
    <div class="flex items-center gap-3">
        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-[var(--btn-regular-bg)]">
            <div class="h-full rounded-full bg-[var(--primary)] transition-all"
                 style={`width: ${percent}%`}></div>
        </div>
        <div class="text-30 text-xs tabular-nums">{percent}%</div>
    </div>

    <div class="flex flex-col gap-2 sm:flex-row">
        {series.prev
            ? <a href={getPostUrlBySlug(series.prev.slug)}
                 class="group flex min-w-0 flex-1 items-center gap-2 rounded-xl bg-[var(--btn-regular-bg)] px-3 py-2 transition hover:bg-[var(--btn-regular-bg-hover)] active:scale-[0.98]">
                <Icon name="material-symbols:chevron-left-rounded" class="shrink-0 text-xl text-[var(--primary)]"></Icon>
                <div class="min-w-0 text-left">
                    <div class="text-30 text-[0.6875rem]">上一章 · {series.prev.index}/{series.total}</div>
                    <div class="truncate text-sm text-75 group-hover:text-[var(--primary)]">{series.prev.title}</div>
                </div>
            </a>
            : <div class="flex min-w-0 flex-1 items-center gap-2 rounded-xl bg-[var(--btn-regular-bg)] px-3 py-2 opacity-40">
                <Icon name="material-symbols:chevron-left-rounded" class="shrink-0 text-xl"></Icon>
                <div class="min-w-0 text-left">
                    <div class="text-30 text-[0.6875rem]">上一章</div>
                    <div class="truncate text-sm text-50">已经是第一章</div>
                </div>
            </div>}

        {series.next
            ? <a href={getPostUrlBySlug(series.next.slug)}
                 class="group flex min-w-0 flex-1 items-center justify-end gap-2 rounded-xl bg-[var(--btn-regular-bg)] px-3 py-2 transition hover:bg-[var(--btn-regular-bg-hover)] active:scale-[0.98]">
                <div class="min-w-0 text-right">
                    <div class="text-30 text-[0.6875rem]">下一章 · {series.next.index}/{series.total}</div>
                    <div class="truncate text-sm text-75 group-hover:text-[var(--primary)]">{series.next.title}</div>
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="shrink-0 text-xl text-[var(--primary)]"></Icon>
            </a>
            : <div class="flex min-w-0 flex-1 items-center justify-end gap-2 rounded-xl bg-[var(--btn-regular-bg)] px-3 py-2 opacity-40">
                <div class="min-w-0 text-right">
                    <div class="text-30 text-[0.6875rem]">下一章</div>
                    <div class="truncate text-sm text-50">已经读到最后一章</div>
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="shrink-0 text-xl"></Icon>
            </div>}
    </div>

    <details class="group">
        <summary class="flex list-none cursor-pointer items-center gap-1 text-50 text-xs transition hover:text-[var(--primary)]">
            <Icon name="material-symbols:list-rounded" class="text-base"></Icon>
            全部章节
            <Icon name="material-symbols:expand-more-rounded" class="text-base transition group-open:rotate-180"></Icon>
        </summary>
        <ol class="mt-3 flex max-h-72 flex-col gap-1 overflow-y-auto pr-1">
            {series.chapters.map((chapter) => (
                <li>
                    <a href={getPostUrlBySlug(chapter.slug)}
                       class:list={["flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition",
                           chapter.slug === series.current.slug
                               ? "bg-[var(--btn-regular-bg)] font-bold text-[var(--primary)]"
                               : "text-75 hover:bg-[var(--btn-plain-bg-hover)] hover:text-[var(--primary)]"]}>
                        <span class="w-6 shrink-0 text-right text-xs text-30 tabular-nums">{chapter.index}</span>
                        <span class="truncate">{chapter.title}</span>
                        {chapter.slug === series.current.slug && (
                            <span class="ml-auto shrink-0 text-[0.6875rem] text-[var(--primary)]">阅读中</span>
                        )}
                    </a>
                </li>
            ))}
        </ol>
    </details>
</div>
