---

import { siteConfig } from "../config";
---

<div
  id="config-carrier"
  data-hue={siteConfig.themeColor.hue}
  data-bg-sources={JSON.stringify(siteConfig.background.random?.sources ?? [])}
  data-bg-timeout={siteConfig.background.random?.timeout ?? 6000}
  data-bg-max-attempts={siteConfig.background.random?.maxAttempts ?? 3}
>
</div>
