---
import type { BacklinkPost } from "@utils/backlinks-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { Icon } from "astro-icon/components";

/**
 * 反向链接：哪些文章在正文里用 `[[slug]]` 指向了当前这篇。
 * 结构和 RelatedPosts 保持一致，视觉上不突兀。
 */
interface Props {
	backlinks: BacklinkPost[];
}

const { backlinks } = Astro.props;
---

{
	backlinks.length > 0 && (
		// data-pagefind-ignore：反链列表依赖构建结果，进搜索索引只会污染片段
		<div
			class="card-base onload-animation mb-5 px-5 py-4"
			data-pagefind-ignore
		>
			<div class="mb-3 flex items-center gap-3">
				<div class="meta-icon !mr-0">
					<Icon name="material-symbols:link-rounded" class="text-lg" />
				</div>
				<div class="font-bold text-90">反向链接</div>
				<div class="ml-auto text-30 text-xs">引用了本文</div>
			</div>

			<div class="flex flex-col gap-1">
				{backlinks.map((post) => (
					<a
						href={post.url}
						class="group flex items-center gap-3 rounded-lg px-3 py-2 transition hover:bg-[var(--btn-plain-bg-hover)]"
					>
						<Icon
							name="material-symbols:chevron-right-rounded"
							class="shrink-0 text-lg text-[var(--primary)] opacity-60 transition group-hover:translate-x-0.5 group-hover:opacity-100"
						/>
						<div class="min-w-0 flex-1">
							<div class="truncate text-sm text-75 transition group-hover:text-[var(--primary)]">
								{post.title}
							</div>
							{post.description && (
								<div class="mt-0.5 truncate text-xs text-30">
									{post.description}
								</div>
							)}
						</div>
						<span class="shrink-0 text-xs text-25 tabular-nums">
							{formatDateToYYYYMMDD(post.published)}
						</span>
					</a>
				))}
			</div>
		</div>
	)
}
