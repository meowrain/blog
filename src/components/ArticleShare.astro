---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config";

interface Props {
	title: string;
	slug: string;
	cardUrl: string;
	date?: string;
	class?: string;
}

const { title, slug, cardUrl, date = "", class: className } = Astro.props;

// 线上 CDN 可能缓存着旧版卡片 / 没有 CORS 头的旧响应，分享用的地址加版本参数换一份缓存
const shareCardUrl = `${cardUrl}${cardUrl.includes("?") ? "&" : "?"}v=3`;
---

<button
	id="article-share"
	type="button"
	data-article-share
	data-title={title}
	data-slug={slug}
	data-card-url={shareCardUrl}
	aria-haspopup="dialog"
	aria-label="分享这篇文章"
	title="分享"
	class:list={[
		className,
		"group inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-lg px-2.5 py-1 text-xs font-medium text-50 transition",
		"hover:bg-[var(--btn-plain-bg-hover)] hover:text-[var(--primary)] active:bg-[var(--btn-plain-bg-active)]",
		"focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary)]",
	]}
>
	<Icon
		name="material-symbols:share"
		class="text-[1rem] transition-transform group-hover:scale-110"
	/>
	<span>分享</span>
</button>

<dialog
	id="article-share-dialog"
	data-article-share-dialog
	aria-labelledby="article-share-title"
	class="fixed inset-0 z-[10000] hidden h-full w-full max-h-none max-w-none items-center justify-center overflow-hidden border-0 bg-black/70 p-3 backdrop-blur-sm sm:p-6"
>
	<div
		data-article-share-panel
		class="flex max-h-[92vh] w-full max-w-3xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl dark:bg-neutral-900"
	>
		<div
			class="flex items-center justify-between gap-2 border-b border-[var(--line-divider)] px-4 py-3"
		>
			<div class="flex min-w-0 items-center gap-2">
				<Icon
					name="material-symbols:share"
					class="shrink-0 text-[1.25rem] text-[var(--primary)]"></Icon>
				<span
					id="article-share-title"
					class="truncate text-base font-semibold text-90">分享这篇文章</span>
			</div>
			<button
				type="button"
				data-article-share-close
				title="关闭"
				aria-label="关闭分享面板"
				class="shrink-0 rounded-lg p-1.5 text-50 transition-colors hover:bg-black/5 hover:text-90 dark:hover:bg-white/10"
			>
				<Icon
					name="material-symbols:close-rounded"
					class="text-[1.5rem]"></Icon>
			</button>
		</div>

		<div class="flex-1 overflow-y-auto p-4">
			<div
				class="relative aspect-[1200/630] overflow-hidden rounded-xl border border-[var(--line-divider)] bg-black/5 dark:bg-white/5"
			>
				<div
					data-article-share-skeleton
					class="absolute inset-0 flex flex-col justify-between overflow-hidden bg-black/[0.03] p-5 dark:bg-white/[0.04] sm:p-7"
				>
					<div class="share-skeleton-sweep"></div>
					<div class="flex items-center gap-2">
						<span
							class="h-2 w-2 animate-pulse rounded-full bg-black/10 dark:bg-white/15"
						></span>
						<span
							class="h-2 w-24 animate-pulse rounded-full bg-black/10 dark:bg-white/15"
						></span>
					</div>
					<div class="space-y-3">
						<div
							class="h-5 w-4/5 animate-pulse rounded-md bg-black/10 dark:bg-white/15 sm:h-7"
						></div>
						<div
							class="h-5 w-3/5 animate-pulse rounded-md bg-black/10 dark:bg-white/15 sm:h-7"
						></div>
					</div>
					<div class="flex items-center justify-between">
						<span
							class="h-2 w-16 animate-pulse rounded-full bg-black/10 dark:bg-white/15"
						></span>
						<span
							class="h-2 w-20 animate-pulse rounded-full bg-black/10 dark:bg-white/15"
						></span>
					</div>
				</div>

				<img
					data-article-share-image
					src={shareCardUrl}
					alt={`${title} 的分享卡片预览`}
					loading="eager"
					decoding="async"
					class="absolute inset-0 hidden h-full w-full object-contain"
				/>

				<div
					data-article-share-fallback
					class="absolute inset-0 hidden flex-col justify-between overflow-hidden border border-[var(--line-divider)] bg-[var(--card-bg)] p-5 sm:p-7"
				>
					<div
						class="pointer-events-none absolute -right-16 -top-20 h-56 w-56 rounded-full bg-[var(--primary)] opacity-20 blur-3xl"
					>
					</div>
					<div
						class="relative flex items-center gap-2 text-xs font-medium text-50"
					>
						<span
							class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--primary)]"
						></span>
						<span class="truncate">{siteConfig.title}</span>
					</div>
					<div
						class="relative line-clamp-3 text-xl font-bold leading-snug text-90 sm:text-2xl"
					>
						{title}
					</div>
					<div
						class="relative flex items-center justify-between gap-3 text-xs text-50"
					>
						<span class="truncate">{date}</span>
						<span class="shrink-0">文章分享卡片</span>
					</div>
				</div>
			</div>

			<div class="mt-4 flex flex-wrap gap-2">
				<button
					type="button"
					data-article-share-system
					class="inline-flex min-w-[6.5rem] flex-1 items-center justify-center gap-1.5 whitespace-nowrap rounded-lg bg-[var(--primary)] px-3 py-2 text-sm font-medium text-white transition hover:opacity-90 active:scale-95 dark:text-black/70"
				>
					<Icon name="material-symbols:share" class="text-[1.125rem]" />
					系统分享
				</button>
				<button
					type="button"
					data-article-share-copy
					class="inline-flex min-w-[6.5rem] flex-1 items-center justify-center gap-1.5 whitespace-nowrap rounded-lg bg-[var(--btn-regular-bg)] px-3 py-2 text-sm font-medium text-[var(--btn-content)] transition hover:bg-[var(--btn-regular-bg-hover)] active:scale-95 active:bg-[var(--btn-regular-bg-active)]"
				>
					<Icon name="material-symbols:link-rounded" class="text-[1.125rem]" />
					复制链接
				</button>
				<button
					type="button"
					data-article-share-download
					class="inline-flex min-w-[6.5rem] flex-1 items-center justify-center gap-1.5 whitespace-nowrap rounded-lg bg-[var(--btn-regular-bg)] px-3 py-2 text-sm font-medium text-[var(--btn-content)] transition hover:bg-[var(--btn-regular-bg-hover)] active:scale-95 active:bg-[var(--btn-regular-bg-active)]"
				>
					<Icon
						name="material-symbols:download-rounded"
						class="text-[1.125rem]"></Icon>
					下载卡片
				</button>
			</div>

			<p class="mt-3 text-center text-xs text-50 sm:text-left">
				{date ? `卡片生成于 ${date}` : "卡片由文章的 OG 图实时生成"}
			</p>
		</div>
	</div>
</dialog>

<script>
	import { mountArticleShare } from "../scripts/article-share";

	// Swup 换页由布局层 page:view 兜底；首次直接进入文章页时这里先挂一次
	mountArticleShare();
</script>

<style>
	/* 骨架屏上一道缓慢扫过的主题色高光，暗示「正在生成」 */
	.share-skeleton-sweep {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			100deg,
			transparent 20%,
			color-mix(in oklab, var(--primary) 22%, transparent) 50%,
			transparent 80%
		);
		transform: translateX(-100%);
		animation: share-skeleton-sweep 1.6s ease-in-out infinite;
		pointer-events: none;
	}

	@keyframes share-skeleton-sweep {
		0% {
			transform: translateX(-100%);
		}
		60%,
		100% {
			transform: translateX(100%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.share-skeleton-sweep {
			animation: none;
			display: none;
		}
	}
</style>
