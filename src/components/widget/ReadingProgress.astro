---
// 全站阅读进度条：不放在 MobileTOC 里，2xl 隐藏移动端目录后仍然存在。
// 组件在 Swup 容器外，跨页不会重建，所以自己监听 Swup 生命周期重新取正文。
---

<div
	id="reading-progress"
	role="progressbar"
	aria-label="阅读进度"
	aria-valuemin="0"
	aria-valuemax="100"
	aria-valuenow="0"
	hidden
>
	<div class="reading-progress-fill"></div>
	<span class="reading-progress-percent" aria-hidden="true">0%</span>
</div>

<style>
	#reading-progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		z-index: 60;
		pointer-events: none;
		background: transparent;
	}

	#reading-progress[hidden] {
		display: none;
	}

	.reading-progress-fill {
		height: 100%;
		width: 0%;
		border-radius: 0 9999px 9999px 0;
		background: var(--primary);
		transition: width 0.12s linear;
	}

	/* 2xl 起移动端目录整体隐藏，用左上角的百分比补上目录抽屉里那份信息 */
	.reading-progress-percent {
		display: none;
	}

	@media (min-width: 1536px) {
		.reading-progress-percent {
			display: block;
			position: fixed;
			top: 0.75rem;
			left: 0.75rem;
			padding: 0.15rem 0.5rem;
			border-radius: 9999px;
			background: var(--float-panel-bg, var(--card-bg));
			color: var(--primary);
			font-size: 0.75rem;
			font-weight: 700;
			font-variant-numeric: tabular-nums;
			line-height: 1.25;
			box-shadow: 0 4px 14px -8px rgba(0, 0, 0, 0.35);
			pointer-events: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reading-progress-fill {
			transition: none;
		}
	}
</style>

<script>
	import { measureReadingProgress } from "../../utils/reading-progress";

	const CONTENT_SELECTOR = "#post-container .markdown-content";

	const bar = document.getElementById("reading-progress");
	const fill =
		bar?.querySelector<HTMLElement>(".reading-progress-fill") ?? null;
	const percentEl =
		bar?.querySelector<HTMLElement>(".reading-progress-percent") ?? null;

	let content: HTMLElement | null = null;
	let rafId = 0;
	let refreshTimer: number | null = null;

	function hide(): void {
		if (!bar) return;
		bar.hidden = true;
		if (fill) fill.style.width = "0%";
		if (percentEl) percentEl.textContent = "0%";
		bar.setAttribute("aria-valuenow", "0");
	}

	function update(): void {
		if (!bar || !fill) return;

		// 切页过程中旧正文已经脱离文档，位置不可信
		if (!content?.isConnected) {
			hide();
			return;
		}

		const percent = Math.round(measureReadingProgress(content) * 100);
		bar.hidden = false;
		fill.style.width = `${percent}%`;
		if (percentEl) percentEl.textContent = `${percent}%`;
		bar.setAttribute("aria-valuenow", String(percent));
	}

	function scheduleUpdate(): void {
		if (rafId) return;
		rafId = requestAnimationFrame(() => {
			rafId = 0;
			update();
		});
	}

	function refresh(): void {
		content = document.querySelector<HTMLElement>(CONTENT_SELECTOR);
		if (!content) {
			hide();
			return;
		}
		update();
	}

	function scheduleRefresh(): void {
		if (refreshTimer) window.clearTimeout(refreshTimer);
		// content:replace 时拿到的还是旧 DOM，等 Swup 写完再扫一次
		refreshTimer = window.setTimeout(() => {
			refreshTimer = null;
			refresh();
		}, 60);
	}

	window.addEventListener("scroll", scheduleUpdate, { passive: true });
	window.addEventListener("resize", scheduleUpdate, { passive: true });

	const bindSwup = (): void => {
		if (!window.swup?.hooks) return;
		window.swup.hooks.on("page:view", scheduleRefresh);
		window.swup.hooks.on("content:replace", scheduleRefresh);
	};

	if (window.swup?.hooks) bindSwup();
	else document.addEventListener("swup:enable", bindSwup, { once: true });

	requestAnimationFrame(refresh);
</script>
