---
// 全局"下雨"特效画布：樱花 / 雨 / 雪 / 枫叶 / 泡泡
// 开关与样式存在 localStorage("falling-effect")，默认关闭，
// 由 DisplaySettings 面板控制，切换时通过 falling-effect-change 事件实时生效。
---
<canvas id="falling-canvas" aria-hidden="true"></canvas>

<style>
  #falling-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
</style>

<script>
  type EffectType = "sakura" | "rain" | "snow" | "maple" | "bubbles";

  const STORAGE_KEY = "falling-effect";

  const canvas = document.getElementById(
    "falling-canvas"
  ) as HTMLCanvasElement;
  const ctx = canvas.getContext("2d");

  let width = 0;
  let height = 0;
  let rafId = 0;
  let running = false;
  let current: EffectType | null = null;
  let particles: Particle[] = [];

  interface Particle {
    update(): void;
    draw(): void;
  }

  class Petal implements Particle {
    x = 0;
    y = 0;
    vx = 0;
    vy = 0;
    opacity = 0;
    size = 0;
    rotation = 0;
    rotationSpeed = 0;
    color = "";

    constructor(initial = false) {
      this.reset(initial);
    }

    reset(initial = false) {
      this.x = Math.random() * width;
      this.y = initial ? Math.random() * height : -20;
      this.vx = Math.random() * 1 + 0.5;
      this.vy = Math.random() * 1 + 0.5;
      this.opacity = Math.random() * 0.5 + 0.3;
      this.size = Math.random() * 10 + 5;
      this.rotation = Math.random() * 360;
      this.rotationSpeed = (Math.random() - 0.5) * 2;
      this.color = `rgba(255, 183, 197, ${this.opacity})`; // Sakura pink
    }

    update() {
      this.x += this.vx;
      this.y += this.vy;
      this.rotation += this.rotationSpeed;
      if (this.y > height + 20) this.reset();
      if (this.x > width + 20) this.x = -20;
    }

    draw() {
      if (!ctx) return;
      ctx.save();
      ctx.translate(this.x, this.y);
      ctx.rotate((this.rotation * Math.PI) / 180);
      ctx.fillStyle = this.color;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.bezierCurveTo(this.size / 2, -this.size / 2, this.size, 0, 0, this.size);
      ctx.bezierCurveTo(-this.size, 0, -this.size / 2, -this.size / 2, 0, 0);
      ctx.fill();
      ctx.restore();
    }
  }

  class RainDrop implements Particle {
    x = 0;
    y = 0;
    speed = 0;
    len = 0;
    drift = 0;

    constructor(initial = false) {
      this.reset(initial);
    }

    reset(initial = false) {
      this.x = Math.random() * (width + 200) - 100;
      this.y = initial ? Math.random() * height : -Math.random() * 120 - 20;
      this.speed = Math.random() * 7 + 9;
      this.len = this.speed * 1.6;
      this.drift = Math.random() * 0.8 - 0.3;
    }

    update() {
      this.y += this.speed;
      this.x += this.drift;
      if (this.y - this.len > height) this.reset();
    }

    draw() {
      if (!ctx) return;
      ctx.strokeStyle = "rgba(174, 194, 224, 0.4)";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(this.x, this.y);
      ctx.lineTo(this.x - this.drift * 3, this.y - this.len);
      ctx.stroke();
    }
  }

  class Snowflake implements Particle {
    x = 0;
    y = 0;
    r = 0;
    vy = 0;
    sway = 0;
    swaySpeed = 0;
    phase = 0;
    opacity = 0;

    constructor(initial = false) {
      this.reset(initial);
    }

    reset(initial = false) {
      this.x = Math.random() * width;
      this.y = initial ? Math.random() * height : -10;
      this.r = Math.random() * 2.5 + 1;
      this.vy = Math.random() * 1.2 + 0.4;
      this.sway = Math.random() * 0.8 + 0.2;
      this.swaySpeed = Math.random() * 0.03 + 0.01;
      this.phase = Math.random() * Math.PI * 2;
      this.opacity = Math.random() * 0.5 + 0.4;
    }

    update() {
      this.phase += this.swaySpeed;
      this.y += this.vy;
      this.x += Math.sin(this.phase) * this.sway;
      if (this.y > height + 10) this.reset();
      if (this.x > width + 10) this.x = -10;
      else if (this.x < -10) this.x = width + 10;
    }

    draw() {
      if (!ctx) return;
      ctx.fillStyle = `rgba(255, 255, 255, ${this.opacity})`;
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  const MAPLE_COLORS = ["#d2691e", "#c94f2a", "#e07b39", "#b22222", "#daa520"];

  class MapleLeaf implements Particle {
    x = 0;
    y = 0;
    vy = 0;
    sway = 0;
    swaySpeed = 0;
    phase = 0;
    size = 0;
    rotation = 0;
    rotationSpeed = 0;
    opacity = 0;
    color = MAPLE_COLORS[0];

    constructor(initial = false) {
      this.reset(initial);
    }

    reset(initial = false) {
      this.x = Math.random() * width;
      this.y = initial ? Math.random() * height : -30;
      this.vy = Math.random() * 0.8 + 0.6;
      this.sway = Math.random() * 1 + 0.3;
      this.swaySpeed = Math.random() * 0.02 + 0.01;
      this.phase = Math.random() * Math.PI * 2;
      this.size = Math.random() * 8 + 6;
      this.rotation = Math.random() * 360;
      this.rotationSpeed = (Math.random() - 0.5) * 3;
      this.opacity = Math.random() * 0.35 + 0.55;
      this.color = MAPLE_COLORS[Math.floor(Math.random() * MAPLE_COLORS.length)];
    }

    update() {
      this.phase += this.swaySpeed;
      this.y += this.vy;
      this.x += Math.sin(this.phase) * this.sway;
      this.rotation += this.rotationSpeed;
      if (this.y > height + 30) this.reset();
      if (this.x > width + 30) this.x = -30;
      else if (this.x < -30) this.x = width + 30;
    }

    draw() {
      if (!ctx) return;
      const s = this.size;
      ctx.save();
      ctx.translate(this.x, this.y);
      ctx.rotate((this.rotation * Math.PI) / 180);
      ctx.globalAlpha = this.opacity;
      ctx.fillStyle = this.color;
      ctx.beginPath();
      // stylized five-lobed leaf
      ctx.moveTo(0, -s);
      ctx.quadraticCurveTo(s * 0.6, -s * 0.6, s * 0.5, -s * 0.1);
      ctx.quadraticCurveTo(s, -s * 0.2, s * 0.6, s * 0.3);
      ctx.quadraticCurveTo(s * 0.4, s * 0.8, 0, s * 0.7);
      ctx.quadraticCurveTo(-s * 0.4, s * 0.8, -s * 0.6, s * 0.3);
      ctx.quadraticCurveTo(-s, -s * 0.2, -s * 0.5, -s * 0.1);
      ctx.quadraticCurveTo(-s * 0.6, -s * 0.6, 0, -s);
      ctx.fill();
      // stem
      ctx.strokeStyle = this.color;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, s * 0.7);
      ctx.lineTo(0, s);
      ctx.stroke();
      ctx.restore();
    }
  }

  class Bubble implements Particle {
    x = 0;
    y = 0;
    r = 0;
    vy = 0;
    phase = 0;
    opacity = 0;

    constructor(initial = false) {
      this.reset(initial);
    }

    reset(initial = false) {
      this.r = Math.random() * 7 + 3;
      this.x = Math.random() * width;
      this.y = initial ? Math.random() * height : height + this.r + 10;
      this.vy = -(Math.random() * 0.7 + 0.3);
      this.phase = Math.random() * Math.PI * 2;
      this.opacity = Math.random() * 0.25 + 0.3;
    }

    update() {
      this.phase += 0.02;
      this.y += this.vy;
      this.x += Math.sin(this.phase) * 0.4;
      if (this.y < -this.r - 10) this.reset();
    }

    draw() {
      if (!ctx) return;
      ctx.strokeStyle = `rgba(160, 210, 255, ${this.opacity})`;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
      ctx.stroke();
      ctx.fillStyle = `rgba(255, 255, 255, ${this.opacity * 0.5})`;
      ctx.beginPath();
      ctx.arc(this.x - this.r * 0.35, this.y - this.r * 0.35, this.r * 0.2, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  // particle counts at 1920x1080, scaled by viewport area
  const EFFECTS: Record<
    EffectType,
    { count: number; create: (initial: boolean) => Particle }
  > = {
    sakura: { count: 50, create: (initial) => new Petal(initial) },
    rain: { count: 150, create: (initial) => new RainDrop(initial) },
    snow: { count: 90, create: (initial) => new Snowflake(initial) },
    maple: { count: 32, create: (initial) => new MapleLeaf(initial) },
    bubbles: { count: 26, create: (initial) => new Bubble(initial) },
  };

  function scaledCount(base: number): number {
    const scale = Math.min(
      Math.max((width * height) / (1920 * 1080), 0.25),
      1.5
    );
    return Math.max(8, Math.round(base * scale));
  }

  function resize() {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
  }

  function start() {
    if (running) return;
    running = true;
    rafId = requestAnimationFrame(tick);
  }

  function stop() {
    running = false;
    cancelAnimationFrame(rafId);
    if (ctx) ctx.clearRect(0, 0, width, height);
  }

  function tick() {
    if (!ctx || !running) return;
    ctx.clearRect(0, 0, width, height);
    for (const p of particles) {
      p.update();
      p.draw();
    }
    rafId = requestAnimationFrame(tick);
  }

  function applyEffect(effect: string) {
    const type = EFFECTS[effect as EffectType]
      ? (effect as EffectType)
      : null;
    if (type === current) return;
    current = type;
    if (!type) {
      stop();
      return;
    }
    resize();
    const conf = EFFECTS[type];
    particles = Array.from({ length: scaledCount(conf.count) }, () =>
      conf.create(true)
    );
    start();
  }

  window.addEventListener("resize", resize);
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) {
      cancelAnimationFrame(rafId);
      running = false;
    } else if (current) {
      start();
    }
  });
  window.addEventListener("falling-effect-change", (event) => {
    applyEffect((event as CustomEvent<string>).detail);
  });

  resize();
  applyEffect(localStorage.getItem(STORAGE_KEY) || "off");
</script>
