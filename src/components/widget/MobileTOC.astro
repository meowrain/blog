---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../../config";

// 组件故意不放在 Swup 容器里：容器（main/#toc）里的 fixed 会被带 transform 的
// #content-wrapper 当成包含块，抽屉就铺不满视口。放在容器外意味着组件会跨页存活，
// 所以目录内容由浏览器端从 .markdown-content 里按当前页标题重建。
const tocDepth = siteConfig.toc.depth;
const tocEnabled = siteConfig.toc.enable;
---

<mobile-toc data-toc-depth={tocDepth} data-toc-enabled={tocEnabled ? "true" : "false"} hidden>
	<button
		type="button"
		class="mobile-toc-toggle"
		aria-label="打开文章目录"
		aria-expanded="false"
		aria-controls="mobile-toc-drawer"
		hidden
	>
		<Icon
			name="material-symbols:format-list-bulleted-rounded"
			class="text-[1.375rem]"
		/>
	</button>

	<div class="mobile-toc-overlay" aria-hidden="true"></div>

	<aside
		id="mobile-toc-drawer"
		class="mobile-toc-drawer"
		role="dialog"
		aria-modal="true"
		aria-label="文章目录"
	>
		<div class="mobile-toc-header">
			<div class="mobile-toc-heading">
				<span class="mobile-toc-title">目录</span>
				<span class="mobile-toc-count">—</span>
			</div>
			<div class="mobile-toc-actions">
				<span class="mobile-toc-percent">0%</span>
				<button type="button" class="mobile-toc-close" aria-label="关闭文章目录">
					<Icon name="material-symbols:close-rounded" class="text-[1.25rem]" />
				</button>
			</div>
		</div>

		<div class="mobile-toc-progress" aria-hidden="true">
			<span class="mobile-toc-progress-bar"></span>
		</div>

		<nav class="mobile-toc-list" aria-label="文章目录"></nav>
	</aside>
</mobile-toc>

<style>
	mobile-toc {
		display: contents;
	}

	mobile-toc[hidden] {
		display: none;
	}

	.mobile-toc-toggle {
		--toc-progress: 0;
		position: fixed;
		right: 1rem;
		bottom: 5.5rem;
		z-index: 40;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 9999px;
		border: 1px solid rgba(0, 0, 0, 0.08);
		background: var(--card-bg);
		color: var(--primary);
		box-shadow: 0 12px 30px -14px rgba(0, 0, 0, 0.45);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	/* 按钮外圈兼职阅读进度环：沿圆周填充，不额外占地方 */
	.mobile-toc-toggle::before {
		content: "";
		position: absolute;
		inset: -3px;
		border-radius: inherit;
		padding: 2px;
		background: conic-gradient(
			var(--primary) calc(var(--toc-progress) * 1%),
			rgba(0, 0, 0, 0.08) 0
		);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask-composite: exclude;
		pointer-events: none;
		transition: background 0.25s ease;
	}

	.mobile-toc-toggle[hidden] {
		display: none;
	}

	.mobile-toc-toggle:active {
		transform: scale(0.92);
	}

	/* lg 起 AI 助手按钮挪到 right-8 / bottom-8，这里跟着让开 */
	@media (min-width: 1024px) {
		.mobile-toc-toggle {
			right: 2rem;
			bottom: 6.5rem;
		}
	}

	.mobile-toc-overlay {
		position: fixed;
		inset: 0;
		z-index: 70;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		background: rgba(0, 0, 0, 0.38);
		-webkit-backdrop-filter: blur(2px);
		backdrop-filter: blur(2px);
		transition:
			opacity 0.25s ease,
			visibility 0.25s;
	}

	mobile-toc.is-open .mobile-toc-overlay {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
	}

	.mobile-toc-drawer {
		position: fixed;
		top: 0;
		right: 0;
		bottom: 0;
		z-index: 71;
		display: flex;
		flex-direction: column;
		width: min(84vw, 21rem);
		visibility: hidden;
		transform: translateX(102%);
		background: var(--float-panel-bg);
		box-shadow: -20px 0 50px -30px rgba(0, 0, 0, 0.4);
		/* visibility 跟着滑出动画结束再隐藏；打开时立刻可见，否则焦点放不进抽屉 */
		transition:
			transform 0.3s cubic-bezier(0.32, 0.72, 0, 1),
			visibility 0s linear 0.3s;
	}

	/* 只有开启磨砂外观时才模糊抽屉背后的内容 */
	:global(html.glass) .mobile-toc-drawer {
		-webkit-backdrop-filter: blur(var(--glass-blur, 22px));
		backdrop-filter: blur(var(--glass-blur, 22px));
	}

	mobile-toc.is-open .mobile-toc-drawer {
		visibility: visible;
		transform: none;
		transition:
			transform 0.3s cubic-bezier(0.32, 0.72, 0, 1),
			visibility 0s linear 0s;
	}

	.mobile-toc-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: calc(env(safe-area-inset-top, 0px) + 1.125rem) 0.75rem 0.75rem 1.125rem;
	}

	.mobile-toc-heading {
		display: flex;
		min-width: 0;
		align-items: center;
		gap: 0.5rem;
	}

	.mobile-toc-title {
		font-size: 0.9375rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: rgba(0, 0, 0, 0.88);
	}

	/* 条目计数：和桌面端目录的头部呼应 */
	.mobile-toc-count {
		font-size: 0.6875rem;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.06em;
		color: rgba(0, 0, 0, 0.35);
		padding: 0.1875rem 0.375rem;
		border-radius: 9999px;
		background: rgba(0, 0, 0, 0.045);
	}

	.mobile-toc-actions {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		gap: 0.25rem;
	}

	.mobile-toc-percent {
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.02em;
		color: var(--primary);
		font-weight: 600;
	}

	/* 头部下方的细进度条，和右上角的百分比是同一个数据 */
	.mobile-toc-progress {
		position: relative;
		height: 2px;
		margin: 0 1.125rem;
		border-radius: 9999px;
		background: rgba(0, 0, 0, 0.06);
		overflow: hidden;
	}

	.mobile-toc-progress-bar {
		display: block;
		width: 0%;
		height: 100%;
		border-radius: inherit;
		background: var(--primary);
		transition: width 0.2s ease;
	}

	.mobile-toc-close {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.625rem;
		color: rgba(0, 0, 0, 0.55);
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}

	.mobile-toc-close:hover,
	.mobile-toc-close:active {
		background: var(--toc-btn-hover);
		color: var(--primary);
	}

	.mobile-toc-list {
		flex: 1;
		overflow-y: auto;
		overscroll-behavior: contain;
		-webkit-overflow-scrolling: touch;
		padding: 0.75rem 0.625rem calc(env(safe-area-inset-bottom, 0px) + 1rem);
		/* 抽屉里不需要看见滚动条，滑动时也没有可见位移提示 */
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.mobile-toc-list::-webkit-scrollbar {
		display: none;
	}

	/* 类名由脚本生成，用 :global 避免被 scope 掉 */
	/* 导轨 + 编号 + 圆点：和桌面端侧栏目录同一套语言，只是间距放大一档 */
	:global(.mobile-toc-page) {
		position: relative;
		padding-left: 0.875rem;
	}

	:global(.mobile-toc-rail) {
		position: absolute;
		top: 0.5rem;
		bottom: 0.5rem;
		left: 0;
		width: 2px;
		border-radius: 9999px;
		background: rgba(0, 0, 0, 0.07);
		-webkit-mask-image: linear-gradient(
			to bottom,
			transparent 0,
			black 0.75rem,
			black calc(100% - 0.75rem),
			transparent 100%
		);
		mask-image: linear-gradient(
			to bottom,
			transparent 0,
			black 0.75rem,
			black calc(100% - 0.75rem),
			transparent 100%
		);
		pointer-events: none;
	}

	:global(.mobile-toc-link) {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		padding: 0.5rem 0.625rem;
		border-radius: 0.625rem;
		font-size: 0.875rem;
		line-height: 1.4;
		color: rgba(0, 0, 0, 0.62);
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}

	/* 每个顶层章节前留一段，长目录不会糊成一片 */
	:global(.mobile-toc-link[data-depth="0"]) {
		margin-top: 0.5rem;
		font-weight: 500;
		color: rgba(0, 0, 0, 0.8);
	}

	:global(.mobile-toc-link[data-depth="0"]:first-of-type) {
		margin-top: 0;
	}

	/* 和桌面端一致：hover 只提亮文字，底色留给当前章节 */
	:global(.mobile-toc-link:not([data-active="true"]):hover) {
		color: rgba(0, 0, 0, 0.85);
	}

	:global(.mobile-toc-link:active) {
		background: rgba(0, 0, 0, 0.06);
	}

	:global(.mobile-toc-link[data-depth="1"]) {
		padding-left: 1rem;
		font-size: 0.8125rem;
	}

	:global(.mobile-toc-link[data-depth="2"]) {
		padding-left: 1.625rem;
		font-size: 0.78125rem;
	}

	:global(.mobile-toc-marker) {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1rem;
		height: calc(1em * 1.4);
		color: rgba(0, 0, 0, 0.34);
	}

	:global(.mobile-toc-index) {
		font-size: 0.625rem;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.02em;
	}

	:global(.mobile-toc-dot) {
		flex-shrink: 0;
		width: 0.3125rem;
		height: 0.3125rem;
		border-radius: 9999px;
		background: currentColor;
		opacity: 0.65;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}

	:global(.mobile-toc-link[data-depth="2"] .mobile-toc-dot) {
		width: 0.25rem;
		height: 0.25rem;
		opacity: 0.5;
	}

	:global(.mobile-toc-text) {
		min-width: 0;
		word-break: break-word;
	}

	/* 当前章节：整块浅底 + 左侧主题色指示条，和桌面端一致 */
	:global(.mobile-toc-link[data-active="true"]) {
		color: var(--primary);
		font-weight: 600;
	}

	:global(.mobile-toc-link[data-active="true"] .mobile-toc-marker) {
		color: var(--primary);
	}

	:global(.mobile-toc-link[data-active="true"] .mobile-toc-dot) {
		opacity: 1;
		transform: scale(1.2);
	}

	:global(.mobile-toc-indicator) {
		position: absolute;
		z-index: 0;
		left: 0;
		right: 0;
		border-radius: 0.625rem;
		background: var(--toc-btn-hover);
		pointer-events: none;
		opacity: 0;
		transition:
			top 0.28s cubic-bezier(0.22, 0.61, 0.36, 1),
			height 0.28s cubic-bezier(0.22, 0.61, 0.36, 1),
			opacity 0.2s ease;
	}

	:global(.mobile-toc-indicator.is-visible) {
		opacity: 1;
	}

	:global(.mobile-toc-indicator)::before {
		content: "";
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 2px;
		border-radius: 9999px;
		background: var(--primary);
		box-shadow: 0 0 10px color-mix(in oklch, var(--primary) 55%, transparent);
	}

	:global(.dark) .mobile-toc-toggle {
		border-color: rgba(255, 255, 255, 0.1);
	}

	:global(.dark) .mobile-toc-toggle::before {
		background: conic-gradient(
			var(--primary) calc(var(--toc-progress) * 1%),
			rgba(255, 255, 255, 0.12) 0
		);
	}

	:global(.dark) .mobile-toc-title {
		color: rgba(255, 255, 255, 0.9);
	}

	:global(.dark) .mobile-toc-count {
		background: rgba(255, 255, 255, 0.08);
		color: rgba(255, 255, 255, 0.4);
	}

	:global(.dark) .mobile-toc-progress {
		background: rgba(255, 255, 255, 0.1);
	}

	:global(.dark) .mobile-toc-close {
		color: rgba(255, 255, 255, 0.55);
	}

	/* 目录项由脚本运行时创建，拿不到 Astro 的 scope 属性，整条选择器都要 global */
	:global(.dark .mobile-toc-page) :global(.mobile-toc-rail) {
		background: rgba(255, 255, 255, 0.09);
	}

	:global(.dark .mobile-toc-link) {
		color: rgba(255, 255, 255, 0.56);
	}

	:global(.dark .mobile-toc-link[data-depth="0"]) {
		color: rgba(255, 255, 255, 0.84);
	}

	:global(.dark .mobile-toc-link:not([data-active="true"]):hover) {
		color: rgba(255, 255, 255, 0.9);
	}

	:global(.dark .mobile-toc-link:active) {
		background: rgba(255, 255, 255, 0.07);
	}

	:global(.dark .mobile-toc-marker) {
		color: rgba(255, 255, 255, 0.34);
	}

	/* 深色下当前章节同样用主题色，别被上面的深色文字规则盖掉 */
	:global(.dark .mobile-toc-link[data-active="true"]) {
		color: var(--primary);
	}

	:global(.dark .mobile-toc-link[data-active="true"] .mobile-toc-marker) {
		color: var(--primary);
	}

	:global(.dark .mobile-toc-indicator) {
		background: rgba(255, 255, 255, 0.07);
	}

	/* AI 助手面板打开时让开它，避免按钮压在面板上 */
	:global(body.find-panel-open) .mobile-toc-toggle {
		display: none;
	}

	/* 2xl 起右侧已有完整 TOC，移动端这套完全不渲染 */
	@media (min-width: 1536px) {
		mobile-toc {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-toc-overlay,
		.mobile-toc-drawer,
		.mobile-toc-progress-bar,
		:global(.mobile-toc-dot),
		:global(.mobile-toc-indicator) {
			transition: none;
		}
	}
</style>

<script>
	import { registerShortcut } from "../../scripts/shortcuts";
	import { measureReadingProgress } from "../../utils/reading-progress";

	type TocHeading = { id: string; text: string; depth: number };

	const HEADING_SELECTOR = "h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]";

	class MobileTOCElement extends HTMLElement {
		private toggle: HTMLButtonElement | null = null;
		private overlay: HTMLElement | null = null;
		private drawer: HTMLElement | null = null;
		private closeButton: HTMLButtonElement | null = null;
		private listEl: HTMLElement | null = null;
		private percentEl: HTMLElement | null = null;
		private countEl: HTMLElement | null = null;
		private progressBarEl: HTMLElement | null = null;
		private indicatorEl: HTMLElement | null = null;
		private links: HTMLAnchorElement[] = [];
		private headingIndex = new Map<Element, number>();
		private observer: IntersectionObserver | null = null;
		private activeIndex = -1;
		private rafId = 0;
		private lastFocused: HTMLElement | null = null;
		private initialized = false;
		private swupBound = false;
		private refreshTimer: number | null = null;
		private contentEl: HTMLElement | null = null;
		private signature = "";
		private unregisterShortcuts: (() => void)[] = [];

		connectedCallback(): void {
			if (this.initialized || !this.isConnected) return;
			this.initialized = true;

			this.toggle = this.querySelector<HTMLButtonElement>(".mobile-toc-toggle");
			this.overlay = this.querySelector<HTMLElement>(".mobile-toc-overlay");
			this.drawer = this.querySelector<HTMLElement>(".mobile-toc-drawer");
			this.closeButton =
				this.querySelector<HTMLButtonElement>(".mobile-toc-close");
			this.listEl = this.querySelector<HTMLElement>(".mobile-toc-list");
			this.percentEl = this.querySelector<HTMLElement>(".mobile-toc-percent");
			this.countEl = this.querySelector<HTMLElement>(".mobile-toc-count");
			this.progressBarEl = this.querySelector<HTMLElement>(
				".mobile-toc-progress-bar",
			);

			this.bindEvents();
			this.bindSwup();
			this.bindReadingLayout();

			// 首屏时正文容器可能还在做进场动画
			requestAnimationFrame(() => this.refresh());
		}

		disconnectedCallback(): void {
			this.observer?.disconnect();
			this.observer = null;
			window.removeEventListener("scroll", this.onScroll);
			window.removeEventListener("resize", this.onScroll);
			window.removeEventListener(
				"reading-layout-change",
				this.onReadingLayoutChange,
			);
			for (const unregister of this.unregisterShortcuts) unregister();
			this.unregisterShortcuts = [];
			this.overlay?.removeEventListener("touchmove", this.blockBackgroundScroll);
			if (this.rafId) {
				cancelAnimationFrame(this.rafId);
				this.rafId = 0;
			}
			if (this.refreshTimer) {
				window.clearTimeout(this.refreshTimer);
				this.refreshTimer = null;
			}
			this.initialized = false;
		}

		private get isOpen(): boolean {
			return this.classList.contains("is-open");
		}

		/**
		 * 切到宽屏 / 沉浸模式时抽屉会被 CSS 收起，但 is-open 还留着：
		 * 一来目录按钮本身也藏起来了，用户没法关；二来快捷键中心会把
		 * 「抽屉打开中」当成弹层，连 Esc 退出模式都拦掉。所以这里主动关掉。
		 */
		private bindReadingLayout(): void {
			window.addEventListener("reading-layout-change", this.onReadingLayoutChange);
		}

		private onReadingLayoutChange = (): void => {
			if (this.isOpen) this.close();
		};

		private bindEvents(): void {
			this.toggle?.addEventListener("click", () => {
				if (this.isOpen) this.close();
				else this.open();
			});
			this.closeButton?.addEventListener("click", () => this.close());
			this.overlay?.addEventListener("click", () => this.close());
			// 遮罩上的滑动/滚轮不该带动背后的正文
			this.overlay?.addEventListener("touchmove", this.blockBackgroundScroll, {
				passive: false,
			});
			this.overlay?.addEventListener("wheel", this.blockBackgroundScroll, {
				passive: false,
			});

			window.addEventListener("scroll", this.onScroll, { passive: true });
			window.addEventListener("resize", this.onScroll, { passive: true });

			// 抽屉打开时接管 Esc 和 Tab；关闭时中心不会把这些键分给它们
			this.unregisterShortcuts.push(
				registerShortcut({
					id: "mobile-toc.escape",
					key: "Escape",
					when: () => this.isOpen,
					whenLayerOpen: true,
					allowInEditable: true,
					priority: 150,
					handler: this.onKeydown,
				}),
				registerShortcut({
					id: "mobile-toc.tab-trap",
					key: "Tab",
					when: () => this.isOpen,
					whenLayerOpen: true,
					allowInEditable: true,
					priority: 150,
					preventDefault: false,
					handler: this.onKeydown,
				}),
			);
		}

		/**
		 * 组件常驻在 Swup 容器之外，切页后不会重新 connected，
		 * 需要自己监听 Swup 的生命周期重建目录。
		 */
		private bindSwup(): void {
			const bind = () => {
				if (this.swupBound || !window.swup?.hooks) return;
				this.swupBound = true;
				window.swup.hooks.on("page:view", this.scheduleRefresh);
				window.swup.hooks.on("content:replace", this.scheduleRefresh);
			};

			if (window.swup?.hooks) bind();
			else document.addEventListener("swup:enable", bind, { once: true });
		}

		private scheduleRefresh = (): void => {
			if (this.refreshTimer) window.clearTimeout(this.refreshTimer);
			// content:replace 时拿到的还是旧 DOM，等 Swup 把页面写完再扫一次
			this.refreshTimer = window.setTimeout(() => {
				this.refreshTimer = null;
				this.refresh();
			}, 60);
		};

		private blockBackgroundScroll = (event: Event): void => {
			if (event.cancelable) event.preventDefault();
		};

		private open(): void {
			if (this.isOpen || !this.hasHeadings) return;
			this.lastFocused =
				document.activeElement instanceof HTMLElement
					? document.activeElement
					: null;
			this.classList.add("is-open");
			this.toggle?.setAttribute("aria-expanded", "true");
			// 抽屉滑入的过渡里字体会重排，等一帧再量位置更稳
			requestAnimationFrame(() => {
				this.positionIndicator(this.activeIndex);
				this.scrollActiveIntoView(false);
			});
			// 抽屉打开前是 visibility:hidden，焦点要等样式生效后才放得进去
			requestAnimationFrame(() => {
				if (this.isOpen) this.closeButton?.focus({ preventScroll: true });
			});
		}

		private close(): void {
			if (!this.isOpen) return;
			this.classList.remove("is-open");
			this.toggle?.setAttribute("aria-expanded", "false");
			this.restoreFocus();
		}

		private restoreFocus(): void {
			const target = this.lastFocused ?? this.toggle;
			// 切页 / 非文章页时按钮可能已经隐藏，别把焦点抢到看不见的地方
			if (!target || !target.isConnected) return;
			if (target === this.toggle && this.toggle?.hidden) return;
			target.focus({ preventScroll: true });
		}

		private onKeydown = (event: KeyboardEvent): void => {
			if (!this.isOpen) return;

			if (event.key === "Escape") {
				event.preventDefault();
				this.close();
				return;
			}

			if (event.key !== "Tab" || !this.drawer) return;

			// 简单的焦点循环，避免 Tab 跑到抽屉背后的页面
			const focusables = Array.from(
				this.drawer.querySelectorAll<HTMLElement>(
					'a[href], button:not([disabled])',
				),
			);
			if (!focusables.length) return;
			const first = focusables[0];
			const last = focusables[focusables.length - 1];
			const active = document.activeElement;
			if (event.shiftKey && active === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && active === last) {
				event.preventDefault();
				first.focus();
			}
		};

		private onScroll = (): void => {
			if (this.rafId) return;
			this.rafId = requestAnimationFrame(() => {
				this.rafId = 0;
				// 目录条目不多，直接按位置算当前章节，比只靠 IO 回调可靠：
				// 大段代码块里可能一个标题都不在激活带上，此时不能停在旧值
				this.updateActiveFromPosition();
				this.updateProgress();
			});
		};

		private get hasHeadings(): boolean {
			return this.links.length > 0;
		}

		/**
		 * 按当前页面重建目录：找正文容器、收集标题、重建 IO。
		 * 非文章页（没有正文容器）直接隐藏整个组件。
		 */
		private refresh(): void {
			if (!this.isConnected) return;

			// 关掉目录时整块隐藏
			const content =
				this.dataset.tocEnabled === "true" ? this.getContentElement() : null;
			if (!content) {
				// 切页收起抽屉，但不还原焦点：即将隐藏的按钮不该被聚焦
				this.classList.remove("is-open");
				this.toggle?.setAttribute("aria-expanded", "false");
				this.hidden = true;
				this.reset();
				return;
			}

			const headings = this.collectHeadings(content);
			const signature = headings.map((h) => h.id).join("|");

			// Swup 每次换页都会替换正文节点：标题名字相同也要重建 IO，
			// 否则观察的还是已经脱离文档的旧标题
			const contentChanged = content !== this.contentEl;
			this.contentEl = content;

			// 标题没变（例如同一页的锚点跳转）就不重建，避免抽屉闪一下
			if (contentChanged || signature !== this.signature) {
				this.signature = signature;
				this.renderLinks(headings, content);
			}

			this.hidden = false;
			// renderLinks 时组件还是 hidden（display:none），量到的尺寸都是 0，
			// 显示出来之后要按真实布局重新摆一次指示条
			this.positionIndicator(this.activeIndex);
			this.updateProgress();
		}

		private reset(): void {
			this.signature = "";
			this.contentEl = null;
			this.activeIndex = -1;
			this.links = [];
			this.headingIndex.clear();
			this.indicatorEl = null;
			this.observer?.disconnect();
			this.observer = null;
			if (this.listEl) this.listEl.replaceChildren();
			if (this.countEl) this.countEl.textContent = "—";
			this.toggle?.setAttribute("hidden", "");
		}

		private getContentElement(): HTMLElement | null {
			// 只认文章页的正文容器；聊天/助手面板里的 .prose 不能算
			return document.querySelector<HTMLElement>(
				"#post-container .markdown-content",
			);
		}

		private collectHeadings(content: HTMLElement): TocHeading[] {
			const maxDepth = Number(this.dataset.tocDepth) || 2;
			const all = Array.from(
				content.querySelectorAll<HTMLElement>(HEADING_SELECTOR),
			).map((heading) => ({
				id: heading.id,
				text: this.headingText(heading),
				depth: Number(heading.tagName.substring(1)),
			}));

			if (!all.length) return [];

			const minDepth = Math.min(...all.map((heading) => heading.depth));
			return all.filter((heading) => heading.depth < minDepth + maxDepth);
		}

		private headingText(heading: HTMLElement): string {
			// rehype-autolink-headings 会往标题末尾追加一个 "#" 锚点
			const clone = heading.cloneNode(true) as HTMLElement;
			for (const anchor of clone.querySelectorAll(".anchor")) anchor.remove();
			return clone.textContent?.trim() ?? "";
		}

		private renderLinks(
			headings: TocHeading[],
			content: HTMLElement,
		): void {
			this.observer?.disconnect();
			this.headingIndex.clear();
			this.activeIndex = -1;

			const page = document.createElement("div");
			page.className = "mobile-toc-page";

			const rail = document.createElement("div");
			rail.className = "mobile-toc-rail";

			const indicator = document.createElement("div");
			indicator.className = "mobile-toc-indicator";

			const fragment = document.createDocumentFragment();
			this.links = [];

			const minDepth = headings.length
				? Math.min(...headings.map((heading) => heading.depth))
				: 0;

			// 顶层标题从 01 开始编号，和桌面端侧栏目录保持一致
			let topIndex = 0;

			for (const heading of headings) {
				const depth = heading.depth - minDepth;

				const link = document.createElement("a");
				link.href = `#${heading.id}`;
				link.className = "mobile-toc-link";
				link.dataset.depth = String(depth);
				link.addEventListener("click", () => this.close());

				const marker = document.createElement("span");
				marker.className = "mobile-toc-marker";
				if (depth === 0) {
					const index = document.createElement("span");
					index.className = "mobile-toc-index";
					index.textContent = String(++topIndex).padStart(2, "0");
					marker.append(index);
				} else {
					const dot = document.createElement("span");
					dot.className = "mobile-toc-dot";
					marker.append(dot);
				}

				const text = document.createElement("span");
				text.className = "mobile-toc-text";
				text.textContent = heading.text;
				link.append(marker, text);

				fragment.appendChild(link);
				this.links.push(link);
			}

			page.append(rail, fragment, indicator);
			this.listEl?.replaceChildren(page);
			this.indicatorEl = indicator;

			if (this.countEl) {
				this.countEl.textContent = String(this.links.length).padStart(2, "0");
			}

			if (!this.links.length) {
				this.toggle?.setAttribute("hidden", "");
				return;
			}

			this.toggle?.removeAttribute("hidden");

			this.observer = new IntersectionObserver(this.onIntersect, {
				// 标题越过视口上方 1/4 处就算进入当前章节；用一条带子触发回调，
				// 具体是哪个章节仍按标题位置算，避免快速滚动时漏掉回调
				rootMargin: "-20% 0px -60% 0px",
				threshold: 0,
			});

			this.links.forEach((link, idx) => {
				const id = decodeURIComponent(link.hash.slice(1));
				const heading =
					content.querySelector<HTMLElement>(`#${CSS.escape(id)}`) ??
					document.getElementById(id);
				if (!heading) return;
				this.headingIndex.set(heading, idx);
				this.observer?.observe(heading);
			});

			// 打开页面的瞬间就把当前章节标出来
			this.updateActiveFromPosition();
		}

		/**
		 * 按标题在视口中的位置选当前章节：越过激活线（视口 25% 处）的最后一个标题。
		 * 标题顺序和目录顺序一致，所以直接顺序扫描即可。
		 */
		private updateActiveFromPosition(): void {
			const cutoff = window.innerHeight * 0.25;
			let current = 0;

			for (const [heading, index] of this.headingIndex) {
				// Swup 换页过渡期间标题可能已经脱离文档，位置不可信
				if (!heading.isConnected) continue;
				if (heading.getBoundingClientRect().top <= cutoff) current = index;
				else break;
			}

			if (current !== this.activeIndex) this.setActive(current);
		}

		// 标题进出激活带时按位置重算一次，比逐条维护布尔状态简单且不会错位
		private onIntersect = (): void => {
			this.updateActiveFromPosition();
			this.updateProgress();
		};

		private setActive(index: number): void {
			this.activeIndex = index;
			this.links.forEach((link, i) => {
				if (i === index) link.dataset.active = "true";
				else link.removeAttribute("data-active");
			});

			this.positionIndicator(index);

			if (this.isOpen) this.scrollActiveIntoView(true);
		}

		/**
		 * 指示条的位置以列表自身为参考系算（offsetTop 相对最近定位祖先），
		 * 抽屉滚动时不会跟着漂；列表滚动后重新算一次即可。
		 */
		private positionIndicator(index: number): void {
			const indicator = this.indicatorEl;
			const link = this.links[index];
			if (!indicator) return;

			if (!link || index < 0) {
				indicator.classList.remove("is-visible");
				return;
			}

			// 相对 .mobile-toc-page 定位，page 是 link 的直接父级
			indicator.style.top = `${link.offsetTop}px`;
			indicator.style.height = `${link.offsetHeight}px`;
			indicator.classList.add("is-visible");
		}

		private scrollActiveIntoView(smooth: boolean): void {
			const link = this.links[this.activeIndex];
			const list = this.listEl;
			if (!link || !list) return;

			const listRect = list.getBoundingClientRect();
			const linkRect = link.getBoundingClientRect();
			const delta =
				linkRect.top - listRect.top - listRect.height / 2 + linkRect.height / 2;

			list.scrollTo({
				top: Math.max(list.scrollTop + delta, 0),
				behavior: smooth ? "smooth" : "auto",
			});
		}

		private updateProgress(): void {
			const content = this.contentEl ?? this.getContentElement();
			if (!content) return;

			const percent = Math.round(measureReadingProgress(content) * 100);
			if (this.percentEl) this.percentEl.textContent = `${percent}%`;
			if (this.progressBarEl) this.progressBarEl.style.width = `${percent}%`;
			// 悬浮按钮外圈的进度环
			this.toggle?.style.setProperty("--toc-progress", String(percent));
		}
	}

	if (!customElements.get("mobile-toc")) {
		customElements.define("mobile-toc", MobileTOCElement);
	}
</script>
