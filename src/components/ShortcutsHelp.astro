---
import { Icon } from "astro-icon/components";
---

<!--
  站级快捷键面板。和图片分享/文章分享一样用 <dialog> + showModal() 进 top layer，
  并且必须放在 Swup 容器之外，换页时面板才能继续存活（切页由脚本主动收起）。
-->
<dialog
	id="shortcuts-help-dialog"
	data-shortcuts-help-dialog
	aria-labelledby="shortcuts-help-title"
	class="fixed inset-0 z-[10000] hidden h-full w-full max-h-none max-w-none items-center justify-center overflow-hidden border-0 bg-black/70 p-3 backdrop-blur-sm sm:p-6"
>
	<div
		data-shortcuts-help-panel
		class="flex max-h-[92vh] w-full max-w-2xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl dark:bg-neutral-900"
	>
		<div
			class="flex items-center justify-between gap-2 border-b border-[var(--line-divider)] px-4 py-3"
		>
			<div class="flex min-w-0 items-center gap-2">
				<Icon
					name="material-symbols:keyboard-outline-rounded"
					class="shrink-0 text-[1.25rem] text-[var(--primary)]"
				/>
				<span
					id="shortcuts-help-title"
					class="truncate text-base font-semibold text-90">键盘快捷键</span
				>
			</div>
			<button
				type="button"
				data-shortcuts-help-close
				title="关闭"
				aria-label="关闭快捷键面板"
				class="shrink-0 rounded-lg p-1.5 text-50 transition-colors hover:bg-black/5 hover:text-90 dark:hover:bg-white/10"
			>
				<Icon
					name="material-symbols:close-rounded"
					class="text-[1.5rem]"
				></Icon>
			</button>
		</div>

		<div class="flex-1 overflow-y-auto p-4">
			<div data-shortcuts-help-list class="space-y-4"></div>
		</div>

		<div
			class="flex items-center justify-between gap-2 border-t border-[var(--line-divider)] px-4 py-3 text-xs text-50"
		>
			<span>按 <kbd class="font-mono font-semibold text-75">?</kbd> 随时打开此面板</span>
			<span>按 <kbd class="font-mono font-semibold text-75">Esc</kbd> 关闭</span>
		</div>
	</div>
</dialog>

<script>
	import { mountShortcuts } from "../scripts/shortcuts";

	mountShortcuts();
</script>
