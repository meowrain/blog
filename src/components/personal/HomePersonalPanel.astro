---
import { profileConfig } from "@/config";
import {
	formatContentDate,
	noteAnchor,
	noteHeading,
} from "@utils/personal-core";
import { getPersonalStats, getSortedNotes } from "@utils/personal-utils";
import { Icon } from "astro-icon/components";

// 首页第一屏除了文章列表，也给「关于 / 项目 / 碎碎念」留入口：
// 站点先是个人主页，然后才是文章库。
const [stats, notes] = await Promise.all([
	getPersonalStats(),
	getSortedNotes(),
]);
const latestNotes = notes.slice(0, 3);

const entries = [
	{
		href: "/about/",
		icon: "material-symbols:person-outline-rounded",
		title: "关于我",
		desc: "在写什么、用什么工具",
	},
	{
		href: "/projects/",
		icon: "material-symbols:rocket-launch-outline-rounded",
		title: "项目",
		desc: `${stats.projects} 个自己写的东西`,
	},
	{
		href: "/notes/",
		icon: "material-symbols:edit-note-rounded",
		title: "碎碎念",
		desc: `${stats.notes} 条短笔记`,
	},
];
---

<div class="card-base mb-4 border border-black/10 p-5 dark:border-white/10 md:p-6">
	<div class="flex flex-wrap items-start justify-between gap-3">
		<div class="min-w-0">
			<div class="flex items-center gap-2">
				<span class="text-90 font-bold text-lg">你好，我是 {profileConfig.name}</span>
				<span class="text-sm text-50">{profileConfig.bio}</span>
			</div>
			<p class="mt-1 text-sm text-50">
				{stats.posts} 篇文章 · {stats.notes} 条碎碎念 · {stats.projects} 个项目
				{stats.firstPublished ? ` · 写作 ${stats.writingYears} 年` : ""}
			</p>
		</div>
		<a
			href="/about/"
			class="inline-flex items-center gap-1 text-sm text-[var(--primary)] transition hover:opacity-80"
		>
			了解更多
			<Icon name="material-symbols:arrow-forward-rounded" class="text-[1rem]" />
		</a>
	</div>

	<div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-3">
		{entries.map((entry) => (
			<a
				href={entry.href}
				class="group flex items-center gap-2.5 rounded-xl bg-[var(--btn-regular-bg)] px-3 py-2.5 transition hover:bg-[var(--btn-regular-bg-hover)]"
			>
				<Icon name={entry.icon} class="text-[1.25rem] text-[var(--primary)]" />
				<div class="min-w-0">
					<div class="truncate text-sm font-bold text-75 transition group-hover:text-[var(--primary)]">
						{entry.title}
					</div>
					<div class="truncate text-xs text-30">{entry.desc}</div>
				</div>
			</a>
		))}
	</div>

	{
		latestNotes.length > 0 && (
			<div class="mt-4 border-t border-dashed border-[var(--line-divider)] pt-3">
				<div class="mb-2 flex items-center justify-between">
					<span class="text-xs font-bold text-50">最近在记</span>
					<a href="/notes/" class="text-xs text-30 transition hover:text-[var(--primary)]">
						全部 →
					</a>
				</div>
				<div class="flex flex-col">
					{latestNotes.map((note) => (
						<a
							href={`/notes/#${noteAnchor(note.slug)}`}
							class="group flex items-center gap-3 rounded-lg px-2 py-1.5 transition hover:bg-[var(--btn-plain-bg-hover)]"
						>
							<span class="shrink-0 font-mono text-xs text-30 tabular-nums">
								{formatContentDate(note.data.published)}
							</span>
							<span class="min-w-0 flex-1 truncate text-sm text-75 transition group-hover:text-[var(--primary)]">
								{noteHeading({ title: note.data.title, published: note.data.published, body: note.body })}
							</span>
						</a>
					))}
				</div>
			</div>
		)
	}
</div>
