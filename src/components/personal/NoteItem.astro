---
import Markdown from "@components/misc/Markdown.astro";
import {
	formatContentDateTime,
	formatCountdown,
	isSealed,
	noteAnchor,
} from "@utils/personal-core";
import type { NoteEntry } from "@utils/personal-utils";
import { Icon } from "astro-icon/components";

interface Props {
	note: NoteEntry;
}

const { note } = Astro.props;

// 没写 title 的碎碎念不渲染标题行，正文直接铺开，时间线更像「随手记」。
const title = (note.data.title ?? "").trim();
const { Content } = await note.render();
const anchor = noteAnchor(note.slug);

// 时间胶囊：构建时过了 unlockAt 就直接展开；还没到就先封存，
// 由 src/scripts/time-capsule.ts 到点翻开（静态页不重新构建也能解锁）。
const unlockAt = note.data.unlockAt;
const sealed = isSealed(unlockAt);
---

<article
	id={anchor}
	class="card-base scroll-mt-24 border border-black/10 px-6 py-5 dark:border-white/10 md:px-8"
	data-time-capsule={unlockAt ? "" : undefined}
	data-unlock-at={unlockAt?.toISOString()}
	data-sealed={unlockAt ? String(sealed) : undefined}
>
	<header class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-50">
		<time datetime={note.data.published.toISOString()} class="font-mono tabular-nums">
			{formatContentDateTime(note.data.published)}
		</time>
		{unlockAt && (
			<span class="inline-flex items-center gap-1 rounded-full bg-[oklch(0.70_0.14_var(--hue)/0.12)] px-2 py-0.5 text-xs text-[var(--primary)]">
				<Icon name="material-symbols:lock-clock-rounded" class="capsule-icon capsule-icon-sealed text-[0.875rem]" />
				<Icon name="material-symbols:lock-open-right-rounded" class="capsule-icon capsule-icon-open text-[0.875rem]" />
				<span class="capsule-label-sealed">封存中</span>
				<span class="capsule-label-open">时间胶囊</span>
			</span>
		)}
		{!sealed && note.data.pinned && (
			<span class="inline-flex items-center gap-1 rounded-full bg-[oklch(0.70_0.14_var(--hue)/0.12)] px-2 py-0.5 text-xs text-[var(--primary)]">
				<Icon name="material-symbols:bolt-rounded" class="text-[0.875rem]" />
				置顶
			</span>
		)}
		{!sealed && note.data.mood && <span class="text-30">心情：{note.data.mood}</span>}
		{!sealed && note.data.location && (
			<span class="inline-flex items-center gap-0.5 text-30">
				<Icon name="material-symbols:location-on-outline-rounded" class="text-[0.875rem]" />
				{note.data.location}
			</span>
		)}
	</header>

	{
		unlockAt && (
			<div class="capsule-sealed mt-3 flex flex-col items-start gap-2 rounded-xl border border-dashed border-[var(--line-divider)] bg-[var(--btn-regular-bg)] px-4 py-4">
				<div class="flex items-center gap-2 text-sm font-bold text-75">
					<Icon name="material-symbols:lock-outline" class="text-[1.125rem] text-[var(--primary)]" />
					这条碎碎念被封存了
				</div>
				<p class="text-sm leading-relaxed text-50">
					封印到 <time datetime={unlockAt.toISOString()}>{formatContentDateTime(unlockAt)}</time>，时间到了会自动展开。
				</p>
				<p class="font-mono text-sm text-[var(--primary)] tabular-nums">
					还有 <span data-capsule-countdown>{formatCountdown(unlockAt)}</span>
				</p>
				<p class="text-xs text-30">内容其实仍在页面源码里，这只是仪式感。</p>
			</div>
		)
	}

	<div class="capsule-revealed">
		{title && (
			<h2 class="mt-2 font-bold text-lg text-90">
				<a href={`#${anchor}`} class="transition hover:text-[var(--primary)]">{title}</a>
			</h2>
		)}

		<Markdown class="mt-2 text-sm leading-relaxed">
			<Content />
		</Markdown>

		{note.data.tags.length > 0 && (
			<footer class="mt-3 flex flex-wrap gap-1.5">
				{note.data.tags.map((tag) => (
					<span class="rounded-full bg-[var(--btn-regular-bg)] px-2 py-0.5 text-xs text-50">#{tag}</span>
				))}
			</footer>
		)}
	</div>
</article>

<style>
	/* 只有时间胶囊会被折叠；普通碎碎念没有 data-time-capsule，不受影响 */
	[data-time-capsule] .capsule-revealed,
	[data-time-capsule] .capsule-icon-open,
	[data-time-capsule] .capsule-label-open {
		display: none;
	}

	[data-time-capsule][data-sealed="false"] .capsule-revealed {
		display: block;
		animation: capsule-open 0.5s ease-out;
	}

	[data-time-capsule][data-sealed="false"] .capsule-sealed,
	[data-time-capsule][data-sealed="false"] .capsule-icon-sealed,
	[data-time-capsule][data-sealed="false"] .capsule-label-sealed {
		display: none;
	}

	[data-time-capsule][data-sealed="false"] .capsule-icon-open {
		display: inline-block;
	}

	[data-time-capsule][data-sealed="false"] .capsule-label-open {
		display: inline;
	}

	@keyframes capsule-open {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		[data-time-capsule][data-sealed="false"] .capsule-revealed {
			animation: none;
		}
	}
</style>
