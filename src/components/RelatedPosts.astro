---
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import type { RelatedPost } from "@utils/related-utils";
import { Icon } from "astro-icon/components";

interface Props {
	posts: RelatedPost[];
}

const { posts } = Astro.props;
---

{
	posts.length > 0 && (
		<div class="card-base onload-animation mb-5 px-5 py-4">
			<div class="mb-3 flex items-center gap-3">
				<div class="meta-icon !mr-0">
					<Icon
						name="material-symbols:auto-awesome-outline-rounded"
						class="text-lg"
					/>
				</div>
				<div class="font-bold text-90">相关文章</div>
				<div class="ml-auto text-30 text-xs">
					按系列 / 标签 / 分类推荐
				</div>
			</div>

			<div class="flex flex-col gap-1">
				{posts.map((post) => (
					<a
						href={post.url}
						class="group flex items-center gap-3 rounded-lg px-3 py-2 transition hover:bg-[var(--btn-plain-bg-hover)]"
					>
						<Icon
							name="material-symbols:chevron-right-rounded"
							class="shrink-0 text-lg text-[var(--primary)] opacity-60 transition group-hover:translate-x-0.5 group-hover:opacity-100"
						/>
						<div class="min-w-0 flex-1">
							<div class="truncate text-sm text-75 transition group-hover:text-[var(--primary)]">
								{post.title}
							</div>
							{post.description && (
								<div class="mt-0.5 truncate text-xs text-30">
									{post.description}
								</div>
							)}
						</div>
						<span class="shrink-0 rounded-md bg-[var(--btn-regular-bg)] px-2 py-0.5 text-[0.6875rem] text-50">
							{post.reason}
						</span>
						<span class="shrink-0 text-xs text-25 tabular-nums">
							{formatDateToYYYYMMDD(post.published)}
						</span>
					</a>
				))}
			</div>
		</div>
	)
}
