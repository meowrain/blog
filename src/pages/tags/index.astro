---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getAllTags } from "@utils/tag-utils";
import { Icon } from "astro-icon/components";

const allPosts = await getSortedPosts();
const tags = await getAllTags(allPosts);
const taggedPosts = allPosts.filter(
	(post) => (post.data.tags ?? []).length > 0,
);
---

<MainGridLayout title="标签">
  <div class="card-base px-8 py-6">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-90 mb-2">文章标签</h1>
      <p class="text-50 text-sm">
        共 {tags.length} 个标签，{taggedPosts.length} 篇打了标签的文章
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      {
        tags.map((tag) => (
          <a
            href={tag.url}
            class="group flex items-center gap-1.5 rounded-lg border border-[var(--line-divider)] bg-[var(--btn-regular-bg)] px-3 py-1.5 transition hover:border-[var(--primary)] hover:bg-[var(--btn-regular-bg-hover)] active:scale-95"
          >
            <Icon
              name="material-symbols:tag-rounded"
              class="text-base text-[var(--primary)]"
            />
            <span class="text-sm font-medium text-75 transition group-hover:text-[var(--primary)]">
              {tag.name}
            </span>
            <span class="text-xs text-30 tabular-nums">{tag.count}</span>
          </a>
        ))
      }
    </div>

    {
      tags.length === 0 && (
        <div class="text-center py-12 text-50">
          <Icon
            name="material-symbols:tag-rounded"
            class="text-6xl mb-4"
          />
          <p>还没有标签，给文章加上 tags frontmatter 就会出现在这里。</p>
        </div>
      )
    }
  </div>
</MainGridLayout>
