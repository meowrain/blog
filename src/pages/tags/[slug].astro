---
import PostList from "@components/PostList.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getAllTags, getPostsByTagSlug } from "@utils/tag-utils";
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";

export const getStaticPaths = (async () => {
	const allPosts = await getSortedPosts();
	const tags = await getAllTags(allPosts);

	return tags.map((tag) => ({
		params: { slug: tag.slug },
		props: { tag },
	}));
}) satisfies GetStaticPaths;

const { tag } = Astro.props;
const allPosts = await getSortedPosts();
const tagPosts = getPostsByTagSlug(allPosts, tag.slug);
---

<MainGridLayout title={`标签: ${tag.name}`}>
  <div class="card-base px-8 py-6">
    <nav class="flex items-center gap-2 text-sm mb-4 text-50">
      <a href="/" class="hover:text-[var(--primary)] transition">
        <Icon name="material-symbols:home-outline-rounded" class="text-lg" />
      </a>
      <Icon name="material-symbols:chevron-right-rounded" class="text-sm" />
      <a href="/tags/" class="hover:text-[var(--primary)] transition">标签</a>
      <Icon name="material-symbols:chevron-right-rounded" class="text-sm" />
      <span class="text-75 font-medium">#{tag.name}</span>
    </nav>

    <div class="mb-6">
      <h1 class="text-2xl font-bold text-90 mb-2">#{tag.name}</h1>
      <p class="text-50 text-sm">共 {tagPosts.length} 篇文章</p>
    </div>

    {
      tagPosts.length > 0 ? (
        <PostList posts={tagPosts} />
      ) : (
        <div class="text-center py-12 text-50">
          <Icon name="material-symbols:tag-rounded" class="text-6xl mb-4" />
          <p>该标签下暂无文章</p>
        </div>
      )
    }
  </div>
</MainGridLayout>
