---
import path from "node:path";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import {
	type SeriesDetail,
	getSeriesDetails,
	seriesPath,
} from "@utils/series-utils";
import { url, getDir, getPostUrlBySlug } from "@utils/url-utils";
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";

export const getStaticPaths = (async () => {
	const details = await getSeriesDetails();
	return details.map((detail) => ({
		params: { slug: detail.slug },
		props: { detail },
	}));
}) satisfies GetStaticPaths;

interface Props {
	detail: SeriesDetail;
}

const { detail } = Astro.props;

const {
	name,
	slug,
	chapters,
	latestPublished,
	description,
	cover,
	coverEntryId,
	publishedCount,
	totalCount,
	totalMinutes,
	first,
	latest,
} = detail;

// 计划总章数只在 frontmatter 写了 seriesTotal 时才有意义，
// 否则分母就是已发布章节数，UI 上不说「未发布」这种话。
const plannedTotal = totalCount ?? publishedCount;
const percent = Math.min(
	100,
	Math.round((publishedCount / plannedTotal) * 100),
);
const hasPlan = totalCount !== null;

const overviewUrl = url("/series/");
// 站内相对路径的封面要带上文章目录：ImageWrapper 以 src/ 为根拼接，
// 不带目录会去 src/ 根下找图。public/ 与外链封面用不到它。
const coverBasePath = coverEntryId
	? getDir(`content/posts/${coverEntryId}`)
	: "";

const pageDescription = [
	name,
	`共 ${publishedCount} 章`,
	`最近更新 ${formatDateToYYYYMMDD(latestPublished)}`,
].join(" · ");

// 首字兜底：没有封面的系列用渐变底 + 系列名第一个字，不额外找图
const initial = Array.from(name)[0] ?? "系";
---

<MainGridLayout title={name} description={pageDescription}>
	<div class="flex flex-col gap-4">
		<!-- 封面 + 简介 -->
		<section class="card-base overflow-hidden">
			<div class="relative h-40 sm:h-52">
				{cover ? (
					<ImageWrapper
						src={cover}
						basePath={coverBasePath}
						alt={`${name} 系列封面`}
						loading="eager"
						class="h-full w-full"
					/>
				) : (
					<div class="flex h-full w-full items-center justify-center bg-[var(--btn-regular-bg)]">
						<span class="text-6xl font-bold text-[var(--primary)] opacity-40">{initial}</span>
					</div>
				)}
				<!-- 上缘压一层同色渐变，标题压在图上也读得清（明暗模式都用主题色） -->
				<div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[var(--card-bg)] via-transparent to-transparent"></div>
			</div>

			<div class="px-6 pb-6 pt-4 sm:px-8">
				<div class="flex flex-wrap items-start justify-between gap-3">
					<div class="min-w-0">
						<h1 class="text-2xl font-bold text-90">{name}</h1>
						<div class="mt-1 text-sm text-50">
							共 {publishedCount} 章 · 累计阅读约 {totalMinutes} 分钟 · 最近更新 {formatDateToYYYYMMDD(latestPublished)}
						</div>
					</div>
					<a href={overviewUrl} class="btn-plain h-9 shrink-0 gap-1 rounded-lg px-3 text-xs">
						<Icon name="material-symbols:arrow-back-rounded" class="text-base"></Icon>
						全部系列
					</a>
				</div>

				{description && <p class="mt-3 text-sm leading-relaxed text-75">{description}</p>}

				<!-- 完成度进度条 -->
				<div class="mt-5">
					<div class="mb-1.5 flex items-center justify-between text-xs text-50">
						<span>
							{hasPlan ? `已发布 ${publishedCount} / ${plannedTotal} 章` : `已发布 ${publishedCount} 章`}
						</span>
						<span class="tabular-nums text-30">{percent}%</span>
					</div>
					<div
						class="h-1.5 w-full overflow-hidden rounded-full bg-[var(--btn-regular-bg)]"
						role="progressbar"
						aria-valuenow={publishedCount}
						aria-valuemin={hasPlan ? 1 : 0}
						aria-valuemax={plannedTotal}
						aria-label={hasPlan ? `${name} 系列完成度` : `${name} 系列已发布章节数`}
					>
						<div class="h-full rounded-full bg-[var(--primary)] transition-all" style={`width: ${percent}%`}></div>
					</div>
				</div>

				<div class="mt-5 flex flex-wrap gap-2">
					<a href={getPostUrlBySlug(first.slug)} class="btn-regular h-9 gap-1 rounded-lg px-4 text-sm">
						<Icon name="material-symbols:play-arrow-rounded" class="text-base"></Icon>
						从头读
					</a>
					{publishedCount > 1 && (
						<a href={getPostUrlBySlug(latest.slug)} class="btn-plain h-9 gap-1 rounded-lg px-4 text-sm">
							<Icon name="material-symbols:bookmark-outline-rounded" class="text-base"></Icon>
							读最新一章
						</a>
					)}
				</div>
			</div>
		</section>

		<!-- 章节目录 -->
		<section class="card-base px-6 py-6 sm:px-8">
			<div class="mb-4 flex items-center gap-2">
				<Icon name="material-symbols:list-rounded" class="text-xl text-[var(--primary)]"></Icon>
				<h2 class="text-lg font-bold text-90">章节目录</h2>
				<span class="text-xs text-30">{publishedCount} 章</span>
			</div>

			<ol class="flex flex-col gap-1">
				{chapters.map((chapter) => (
					<li>
						<a
							href={getPostUrlBySlug(chapter.slug)}
							class="group flex items-center gap-3 rounded-lg px-3 py-2.5 transition hover:bg-[var(--btn-plain-bg-hover)]"
						>
							<span class="w-7 shrink-0 text-right text-xs text-30 tabular-nums group-hover:text-[var(--primary)]">
								{chapter.index}
							</span>
							<div class="min-w-0 flex-1">
								<div class="truncate text-sm text-75 group-hover:text-[var(--primary)]">{chapter.title}</div>
								<div class="mt-0.5 flex gap-2 text-[0.6875rem] text-30">
									<span>{formatDateToYYYYMMDD(chapter.published)}</span>
									{chapter.minutes > 0 && (
										<>
											<span>|</span>
											<span>{chapter.minutes} 分钟</span>
										</>
									)}
								</div>
							</div>
							<Icon
								name="material-symbols:chevron-right-rounded"
								class="shrink-0 text-lg text-25 transition group-hover:text-[var(--primary)]"
							></Icon>
						</a>
					</li>
				))}
			</ol>
		</section>
	</div>
</MainGridLayout>
