---
import { profileConfig, siteConfig } from "@/config";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import ProjectCard from "@components/personal/ProjectCard.astro";
import StatCard from "@components/personal/StatCard.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { formatContentDate } from "@utils/personal-core";
import {
	getAboutEntry,
	getPersonalStats,
	getSortedProjects,
} from "@utils/personal-utils";
import { Icon } from "astro-icon/components";

const [about, stats, projects] = await Promise.all([
	getAboutEntry(),
	getPersonalStats(),
	getSortedProjects(),
]);

// 关于页只放最前面的两三个项目，完整列表在 /projects/
const featuredProjects = projects.slice(0, 2);

const title = about?.data.title || "关于我";
const { Content } = about ? await about.render() : { Content: null };

const cover = stats.firstPublished
	? `${formatContentDate(stats.firstPublished)} 至今`
	: "";

// 版权块的日期：优先用 about.md 的 updated，没有就退回第一篇文章的发布时间
const aboutPubDate = about?.data.updated ?? stats.firstPublished;
---

<MainGridLayout title={title} description={about?.data.description || "关于 MeowRain：写 Java 和 Go 的后端开发，折腾服务器、博客和一堆小工具。"}>
	<div class="flex flex-col gap-4">
		<!-- 名片 -->
		<div class="card-base relative overflow-hidden border border-black/10 px-6 py-7 dark:border-white/10 md:px-9 md:py-8">
			<!-- 装饰光斑，和磨砂背景呼应 -->
			<div class="pointer-events-none absolute -right-16 -top-20 h-56 w-56 rounded-full bg-[oklch(0.70_0.14_var(--hue)/0.12)] blur-3xl" />

			<div class="relative flex flex-col items-start gap-5 sm:flex-row">
				<div class="relative h-24 w-24 shrink-0 overflow-hidden rounded-2xl" style={`--theme-hue: ${siteConfig.themeColor.hue}`}>
					<div class="loading-bar absolute left-1/2 top-1/2 z-10 h-1 w-32 -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700">
						<div class="loading-progress animate-loading-progress h-full w-8 rounded-full bg-[oklch(0.70_0.14_var(--theme-hue))]" />
					</div>
					<img
						src={profileConfig.avatar}
						alt={`${profileConfig.name} 的头像`}
						loading="eager"
						decoding="async"
						class="h-full w-full object-cover opacity-0 transition-opacity duration-500"
						onload="this.style.opacity='1'; const b=this.parentElement.querySelector('.loading-bar'); if(b) b.style.display='none';"
						onerror="const b=this.parentElement.querySelector('.loading-bar'); if(b) b.style.display='none';"
					/>
				</div>

				<div class="min-w-0 flex-1">
					<h1 class="text-2xl font-bold text-90 md:text-3xl">{profileConfig.name}</h1>
					<p class="mt-1 text-sm text-50">{profileConfig.bio}</p>
					<div class="mt-3 flex flex-wrap gap-2">
						{profileConfig.links.map((link) => (
							<a
								rel="me noopener noreferrer"
								aria-label={link.name}
								href={link.url}
								target="_blank"
								class="btn-regular h-9 gap-1.5 px-3 text-sm"
							>
								<Icon name={link.icon} class="text-[1.1rem]" />
								{link.name}
							</a>
						))}
					</div>
				</div>
			</div>

			{cover && (
				<div class="relative mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-30">
					<span class="inline-flex items-center gap-1">
						<Icon name="material-symbols:history-rounded" class="text-[1rem]" />
						写作 {cover}
					</span>
					{about?.data.updated && <span>本页更新于 {formatContentDate(about.data.updated)}</span>}
					<a href="/rss.xml" class="transition hover:text-[var(--primary)]">RSS 订阅</a>
				</div>
			)}
		</div>

		<!-- 站点数据 -->
		<div class="grid grid-cols-2 gap-3 md:grid-cols-4">
			<StatCard value={stats.posts} label="篇文章" icon="material-symbols:article-outline-rounded" href="/archive/" />
			<StatCard value={stats.notes} label="条碎碎念" icon="material-symbols:edit-note-rounded" href="/notes/" />
			<StatCard value={stats.projects} label="个项目" icon="material-symbols:rocket-launch-outline-rounded" href="/projects/" />
			<StatCard value={stats.seriesCount} label="个系列" icon="material-symbols:library-books-outline-rounded" href="/series/" />
		</div>

		<!-- 正文 -->
		{
			Content ? (
				<article class="card-base border border-black/10 px-6 py-6 dark:border-white/10 md:px-9 md:py-7">
					<Markdown>
						<Content />
					</Markdown>
				</article>
			) : (
				<div class="card-base border border-black/10 px-6 py-6 text-sm text-50 dark:border-white/10 md:px-9">
					在 <code>src/content/about/about.md</code> 里写下自我介绍，这里就会显示。
				</div>
			)
		}

		<!-- 常写的标签 -->
		{
			stats.topTags.length > 0 && (
				<section class="card-base border border-black/10 px-6 py-5 dark:border-white/10 md:px-8">
					<div class="flex items-center gap-2">
						<Icon name="material-symbols:tag-rounded" class="text-[var(--primary)]" />
						<h2 class="text-lg font-bold text-90">常写的主题</h2>
					</div>
					<div class="mt-3 flex flex-wrap gap-2">
						{stats.topTags.map((tag) => (
							<span class="inline-flex items-center gap-1 rounded-full bg-[var(--btn-regular-bg)] px-3 py-1 text-xs text-50">
								#{tag.name}
								<span class="text-25 tabular-nums">{tag.count}</span>
							</span>
						))}
					</div>
				</section>
			)
		}

		<!-- 项目 -->
		{
			featuredProjects.length > 0 && (
				<section class="flex flex-col gap-3">
					<div class="flex items-center gap-3 px-1">
						<span class="rounded-full bg-[var(--btn-regular-bg)] px-3 py-1 text-xs font-bold text-[var(--btn-content)]">
							最近在做的
						</span>
						<div class="h-px flex-1 bg-[var(--line-divider)]" />
						<a href="/projects/" class="text-xs text-50 transition hover:text-[var(--primary)]">全部项目 →</a>
					</div>
					<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
						{featuredProjects.map((project) => (
							<ProjectCard
								title={project.data.title}
								description={project.data.description}
								icon={project.data.icon}
								tags={project.data.tags}
								status={project.data.status}
								url={project.data.url}
								repo={project.data.repo}
								href={`/projects/${project.slug}/`}
							/>
						))}
					</div>
				</section>
			)
		}

		<!-- 继续逛 -->
		<div class="grid grid-cols-1 gap-3 md:grid-cols-3">
			<a href="/notes/" class="card-base group flex items-center gap-3 border border-black/10 px-5 py-4 dark:border-white/10">
				<Icon name="material-symbols:edit-note-rounded" class="text-2xl text-[var(--primary)]" />
				<div class="min-w-0">
					<div class="font-bold text-90 transition group-hover:text-[var(--primary)]">碎碎念</div>
					<div class="text-xs text-50">短笔记和随手记</div>
				</div>
			</a>
			<a href="/archive/" class="card-base group flex items-center gap-3 border border-black/10 px-5 py-4 dark:border-white/10">
				<Icon name="material-symbols:archive-outline-rounded" class="text-2xl text-[var(--primary)]" />
				<div class="min-w-0">
					<div class="font-bold text-90 transition group-hover:text-[var(--primary)]">归档</div>
					<div class="text-xs text-50">按时间翻所有文章</div>
				</div>
			</a>
			<a href="/friends/" class="card-base group flex items-center gap-3 border border-black/10 px-5 py-4 dark:border-white/10">
				<Icon name="material-symbols:diversity-3" class="text-2xl text-[var(--primary)]" />
				<div class="min-w-0">
					<div class="font-bold text-90 transition group-hover:text-[var(--primary)]">友链</div>
					<div class="text-xs text-50">常去逛的博客</div>
				</div>
			</a>
		</div>

		{about && aboutPubDate && (
			<License
				title={title}
				slug="about"
				pubDate={aboutPubDate}
				class="rounded-xl license-container"
			/>
		)}
	</div>
</MainGridLayout>
