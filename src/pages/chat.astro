---
import ChatPanel from "@components/chat/ChatPanel.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout
	title="AI 助手"
	description="问点什么：AI 助手会联网查资料，也能翻站内文章，答案里的来源都可以点开核对。"
>
	<div id="chat-page" class="space-y-4">
		<header class="card-base p-6 md:p-8">
			<div class="flex items-center gap-3">
				<div
					class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[var(--primary)] text-white dark:text-black/70"
				>
					<Icon name="material-symbols:forum-outline-rounded" class="text-[1.6rem]" />
				</div>
				<div class="min-w-0">
					<h1 class="text-2xl font-black text-90">AI 助手</h1>
					<p class="mt-1 text-sm leading-relaxed text-50">
						技术问题、概念解释、写段代码都可以问。涉及事实和最新消息时它会自己联网查，
						答案里会给出来源链接；问站内文章，它会翻我的文章索引。
					</p>
				</div>
			</div>
		</header>

		<ChatPanel client:only="svelte" />
	</div>
</MainGridLayout>