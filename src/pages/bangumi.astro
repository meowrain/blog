---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import snapshot from "@/data/bangumi.json";

// 数据来自构建期快照（scripts/bangumi-snapshot.js），这一页运行时不发任何请求：
// api.bgm.tv 和 lain.bgm.tv 在 EdgeOne 边缘节点与国内访客浏览器里都连不通，
// 所以收藏内容和封面图都在本地抓好、随仓库一起构建。
// 更新方式：本地带代理跑 `pnpm bangumi:snapshot`，提交生成的 JSON 与图片。

type CollectionItem = {
  subjectId: number;
  type: number;
  title: string;
  originalTitle: string;
  cover: string | null;
  date: string;
  eps: number;
  score: number;
  rate: number;
  epStatus: number;
  tags: string[];
  comment: string;
};

const statusLabels: Record<string, string> = {
  "3": "在看",
  "1": "想看",
  "2": "看过",
  "4": "搁置",
  "5": "抛弃",
};
const statusOrder = ["3", "1", "2", "4", "5"];

const items = snapshot.items as CollectionItem[];
const countOf = (type: string) => items.filter((item) => String(item.type) === type).length;

// 「在看」可能一条公开都没有：落到第一个有条目的档位，
// 免得页面打开就是一片空列表。
const activeType = statusOrder.find((type) => countOf(type) > 0) ?? "3";

function formatGeneratedAt(iso: string): string {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return iso;
  return new Intl.DateTimeFormat("zh-CN", {
    timeZone: "Asia/Shanghai",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  }).format(date);
}

function formatDate(date?: string): string {
  if (!date) return "日期未知";
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;
  return new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "short" }).format(parsed);
}

// ep_status 只在真填了进度时才有值：标成「看过」但没记话数的条目很常见，
// 这时画一根 0% 的进度条会被读成「一集没看」，所以只留文字。
function progressOf(item: CollectionItem): { text: string; percent: number; showBar: boolean } {
  const watched = Math.max(0, item.epStatus);
  if (watched <= 0) return { text: "进度未记录", percent: 0, showBar: false };
  if (item.eps > 0) {
    return {
      text: `${watched} / ${item.eps} 话`,
      percent: Math.min(100, Math.round((watched / item.eps) * 100)),
      showBar: true,
    };
  }
  return { text: `${watched} 话`, percent: 0, showBar: false };
}

const displayName = snapshot.user.nickname || snapshot.username;
const avatarUrl = snapshot.user.avatar || "";
const bangumiListUrl = `https://bgm.tv/anime/list/${snapshot.username}`;
const generatedAt = formatGeneratedAt(snapshot.generatedAt);
---

<MainGridLayout title="追番" description="同步 Bangumi 上的动画收藏与观看进度">
  <div id="bangumi-page" data-active-type={activeType} class="space-y-4">
    <section class="card-base bangumi-panel p-5 md:p-7">
      <header class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
        <div class="flex items-start gap-3">
          <div
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[var(--primary)] text-white dark:text-black/70"
          >
            <Icon name="material-symbols:live-tv-outline-rounded" class="text-[1.6rem]" />
          </div>
          <div>
            <h1 class="text-2xl font-bold text-90">追番</h1>
            <p class="mt-1 text-sm text-50">从 Bangumi 公开收藏读取动画进度</p>
          </div>
        </div>

        <a
          href={bangumiListUrl}
          target="_blank"
          rel="noopener"
          class="btn-regular bangumi-source-link self-start rounded-lg px-3 py-2 text-sm font-medium"
        >
          <Icon name="material-symbols:open-in-new-rounded" class="mr-1.5 text-[1rem]" />
          在 Bangumi 查看
        </a>
      </header>

      <div class="mt-4 flex items-start gap-1.5 text-xs leading-5 text-50">
        <Icon name="material-symbols:info-outline-rounded" class="mt-0.5 shrink-0 text-[1rem]" />
        <span>
          数据是构建时抓取的快照，更新于 {generatedAt}。只包含 Bangumi 上的公开收藏，设成私密的条目
          API 读不到；要刷新内容，重新跑一次 <code class="bangumi-code">pnpm bangumi:snapshot</code>
          并提交生成的文件。
        </span>
      </div>
    </section>

    <section id="bangumi-profile" class="card-base bangumi-panel p-5 md:p-6">
      <div class="flex items-center gap-4">
        <div
          class="relative flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-full bg-black/5 text-lg font-bold text-50 dark:bg-white/5"
        >
          <span class="absolute inset-0 flex items-center justify-center">
            {displayName.slice(0, 1).toUpperCase()}
          </span>
          {
            avatarUrl && (
              <img
                src={avatarUrl}
                alt={`${displayName} 的头像`}
                class="relative z-[1] h-full w-full object-cover"
                onerror="this.remove()"
              />
            )
          }
        </div>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="truncate text-lg font-bold text-90">{displayName}</h2>
            <span class="rounded-full bg-black/5 px-2 py-0.5 text-xs text-50 dark:bg-white/5">
              @{snapshot.username}
            </span>
          </div>
          <p class="mt-1 line-clamp-2 text-sm leading-6 text-50">
            {snapshot.user.sign || "这个用户还没有写签名。"}
          </p>
        </div>
        <a
          href={snapshot.user.url}
          target="_blank"
          rel="noopener"
          class="btn-plain ml-auto hidden h-10 w-10 shrink-0 rounded-lg sm:flex"
          aria-label="打开 Bangumi 用户主页"
        >
          <Icon name="material-symbols:arrow-outward-rounded" class="text-[1.25rem]" />
        </a>
      </div>

      <div id="bangumi-stats" class="mt-5 grid grid-cols-3 gap-2 sm:grid-cols-5">
        {
          statusOrder.map((type) => (
            <button
              type="button"
              data-status={type}
              class="bangumi-status-tab rounded-xl border border-black/10 bg-black/[0.025] px-3 py-3 text-left transition hover:border-[var(--primary)] hover:bg-[var(--btn-regular-bg-hover)] active:scale-[0.98] dark:border-white/10 dark:bg-white/[0.045]"
            >
              <span class="block text-xs text-50">{statusLabels[type]}</span>
              <span class="mt-1 block text-lg font-bold text-90">{countOf(type)}</span>
            </button>
          ))
        }
      </div>
    </section>

    <section class="card-base bangumi-panel p-5 md:p-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="flex items-center gap-2">
            <h2 id="bangumi-list-title" class="text-lg font-bold text-90">
              {statusLabels[activeType]}
            </h2>
            <span
              id="bangumi-list-count"
              class="rounded-full bg-[var(--btn-regular-bg)] px-2 py-0.5 text-xs font-medium text-[var(--btn-content)]"
            >
              {countOf(activeType)}
            </span>
          </div>
          <p id="bangumi-list-subtitle" class="mt-1 text-sm text-50">
            {countOf(activeType) > 0
              ? `共 ${countOf(activeType)} 部，按 Bangumi 收藏顺序展示`
              : "这个状态下还没有动画条目"}
          </p>
        </div>
      </div>

      <div id="bangumi-card-grid" class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {
          items.map((item) => {
            const progress = progressOf(item);
            return (
              <a
                href={`https://bgm.tv/subject/${item.subjectId}`}
                target="_blank"
                rel="noopener"
                class="bangumi-card group"
                data-status={String(item.type)}
                hidden={String(item.type) !== activeType}
              >
                <div class="bangumi-cover">
                  <div class="bangumi-cover-placeholder">
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 fill-current">
                      <path d="m4 4l1.625 3.25q.175.35.5.55t.7.2q.75 0 1.15-.638t.05-1.312L7 4h2l1.625 3.25q.175.35.5.55t.7.2q.75 0 1.15-.638t.05-1.312L12 4h2l1.625 3.25q.175.35.5.55t.7.2q.75 0 1.15-.638t.05-1.312L17 4h3q.825 0 1.413.587T22 6v12q0 .825-.587 1.413T20 20H4q-.825 0-1.412-.587T2 18V6q0-.825.588-1.412T4 4m0 6v8h16v-8z" />
                    </svg>
                    <span class="text-[10px]">暂无封面</span>
                  </div>
                  {
                    item.cover && (
                      <img
                        src={item.cover}
                        alt={`${item.title} 封面`}
                        loading="lazy"
                        onerror="this.classList.add('is-missing')"
                      />
                    )
                  }
                  <span class="bangumi-status-chip">
                    {statusLabels[String(item.type)] || "动画"}
                  </span>
                </div>

                <div class="flex min-w-0 flex-1 flex-col">
                  <h3 class="line-clamp-2 text-sm font-bold leading-5 text-90 transition group-hover:text-[var(--primary)]">
                    {item.title}
                  </h3>
                  {
                    item.originalTitle && (
                      <p class="mt-1 line-clamp-1 text-xs text-30">{item.originalTitle}</p>
                    )
                  }

                  <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-50">
                    <span class="inline-flex items-center gap-1">
                      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-current">
                        <path d="m12 17.27 6.18 3.73-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                      </svg>
                      {item.score > 0 ? item.score.toFixed(1) : "暂无评分"}
                    </span>
                    {
                      item.rate > 0 && (
                        <span class="rounded-md bg-[var(--btn-regular-bg)] px-1.5 py-0.5 font-medium text-[var(--btn-content)]">
                          我的 {item.rate} 分
                        </span>
                      )
                    }
                    <span>{formatDate(item.date)}</span>
                  </div>

                  <div class="mt-3">
                    <div class="mb-1.5 flex items-center justify-between text-[11px] text-50">
                      <span>{progress.text}</span>
                      {progress.showBar && <span>{progress.percent}%</span>}
                    </div>
                    {
                      progress.showBar && (
                        <div class="bangumi-progress-track">
                          <div
                            class="bangumi-progress-bar"
                            style={`width: ${progress.percent}%`}
                          />
                        </div>
                      )
                    }
                  </div>

                  {
                    item.tags.length > 0 && (
                      <div class="mt-3 flex flex-wrap gap-1">
                        {item.tags.map((tag) => (
                          <span class="bangumi-tag">{tag}</span>
                        ))}
                      </div>
                    )
                  }

                  {
                    item.comment && (
                      <p class="mt-3 line-clamp-2 text-xs leading-5 text-50">{item.comment}</p>
                    )
                  }
                </div>
              </a>
            );
          })
        }
      </div>

      <div
        id="bangumi-list-empty"
        class="hidden flex-col items-center justify-center py-14 text-center"
      >
        <Icon name="material-symbols:movie-outline-rounded" class="mb-3 text-[2.5rem] text-25" />
        <p class="text-sm text-50">这个状态下还没有动画条目。</p>
      </div>

      <div
        id="bangumi-pagination"
        class="mt-5 hidden items-center justify-between border-t border-black/5 pt-4 dark:border-white/5"
      >
        <button
          id="bangumi-prev"
          type="button"
          class="btn-regular rounded-lg px-3 py-2 text-sm font-medium disabled:pointer-events-none disabled:opacity-40"
        >
          <Icon name="material-symbols:chevron-left-rounded" class="mr-1 text-[1.1rem]" />
          上一页
        </button>
        <span id="bangumi-page-label" class="text-xs text-50">1 / 1</span>
        <button
          id="bangumi-next"
          type="button"
          class="btn-regular rounded-lg px-3 py-2 text-sm font-medium disabled:pointer-events-none disabled:opacity-40"
        >
          下一页
          <Icon name="material-symbols:chevron-right-rounded" class="ml-1 text-[1.1rem]" />
        </button>
      </div>
    </section>
  </div>
</MainGridLayout>

<!-- 卡片是服务端渲染进 HTML 的，但切换档位时靠 hidden 属性显示/隐藏，
     这段样式保持全局以免 Tailwind 的 .hidden 被 .bangumi-card 的 display:flex 盖掉。 -->
<style is:global>
  #bangumi-page {
    min-width: 0;
  }

  #bangumi-page :where(p, h1, h2, h3, span) {
    overflow-wrap: anywhere;
  }

  #bangumi-page .bangumi-card[hidden] {
    display: none;
  }

  @media (max-width: 639px) {
    #bangumi-page {
      width: calc(100vw - 2rem);
      max-width: calc(100vw - 2rem);
    }
  }

  .bangumi-panel:hover {
    transform: none;
    box-shadow: none;
  }

  .bangumi-status-tab.is-active {
    border-color: var(--primary);
    background: var(--btn-regular-bg-hover);
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--primary) 55%, transparent);
  }

  .bangumi-code {
    @apply rounded bg-black/5 px-1 py-0.5 font-mono text-[0.95em] dark:bg-white/10;
  }

  .bangumi-card {
    @apply flex min-w-0 gap-3 overflow-hidden rounded-xl border border-black/10 bg-[var(--card-bg)] p-3 transition duration-200 dark:border-white/10;
  }

  .bangumi-card:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
  }

  .bangumi-cover {
    @apply relative aspect-[3/4] w-[5.75rem] shrink-0 overflow-hidden rounded-lg bg-black/5 dark:bg-white/5;
  }

  .bangumi-cover img {
    @apply relative z-[1] h-full w-full object-cover transition duration-300;
  }

  .bangumi-card:hover .bangumi-cover img {
    transform: scale(1.04);
  }

  .bangumi-cover img.is-missing {
    display: none;
  }

  .bangumi-cover-placeholder {
    @apply absolute inset-0 z-0 flex flex-col items-center justify-center gap-1 text-black/25 dark:text-white/25;
  }

  .bangumi-status-chip {
    @apply absolute left-2 top-2 z-[2] rounded-full bg-black/65 px-2 py-0.5 text-[10px] font-medium text-white backdrop-blur-sm;
  }

  .bangumi-progress-track {
    @apply h-1.5 w-full overflow-hidden rounded-full bg-black/10 dark:bg-white/10;
  }

  .bangumi-progress-bar {
    @apply h-full rounded-full bg-[var(--primary)] transition-[width] duration-500;
  }

  .bangumi-tag {
    @apply rounded-md bg-black/5 px-1.5 py-0.5 text-[10px] text-black/50 dark:bg-white/5 dark:text-white/50;
  }

  @media (prefers-reduced-motion: reduce) {
    .bangumi-card,
    .bangumi-cover img,
    .bangumi-progress-bar {
      transition: none;
    }
  }
</style>

