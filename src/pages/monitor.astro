---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

// 监控面板上游会校验 Origin，浏览器直连 status.acetaffy.mom 会被 403，
// 所以默认走同源的 EdgeOne Pages Function（functions/api/komari/[[path]].js）。
// 本地开发时 astro dev 不会挂载 functions/，可把 PUBLIC_KOMARI_API_BASE 指向
// 一个同源反代，或直接填面板地址（需自行放开 CORS）。
const komariRpcUrl = import.meta.env.PUBLIC_KOMARI_RPC_URL || "/api/komari/rpc2";
const komariPanelUrl = import.meta.env.PUBLIC_KOMARI_PANEL_URL || "https://status.acetaffy.mom";
---

<MainGridLayout title="监控" description="服务器集群实时负载、网络吞吐与在线状态">
  <div
    id="monitor-page"
    data-rpc-url={komariRpcUrl}
    data-panel-url={komariPanelUrl}
    class="space-y-4"
  >
    <!-- 出错时整页替换成这一段，retry 按钮复用同一套载入逻辑 -->
    <section id="mon-error" class="card-base mon-panel hidden p-5 md:p-7">
      <div class="flex items-start gap-3">
        <div
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[var(--btn-regular-bg)] text-[var(--btn-content)]"
        >
          <Icon name="material-symbols:error-outline-rounded" size="1.35rem" />
        </div>
        <div class="min-w-0">
          <h2 id="mon-error-title" class="text-lg font-bold text-[var(--mon-text-1)]">
            无法载入监控数据
          </h2>
          <p id="mon-error-desc" class="mt-1 text-sm leading-relaxed text-[var(--btn-content)]">
            监控接口暂时没有响应。
          </p>
        </div>
      </div>
      <button
        id="mon-retry"
        type="button"
        class="btn-regular mt-4 h-10 rounded-lg px-4 text-sm font-bold"
      >
        重新载入
      </button>
    </section>

    <!-- 首屏骨架：与真实数据同构，避免数值抵达时版面跳动 -->
    <section id="mon-skeleton" class="space-y-4">
      <div class="card-base mon-panel p-5 md:p-7">
        <div class="mon-skeleton-line h-7 w-48"></div>
        <div class="mon-skeleton-line mt-2 h-4 w-72"></div>
        <div class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-6">
          {Array.from({ length: 6 }).map(() => <div class="mon-skeleton-block h-[4.5rem]"></div>)}
        </div>
      </div>
      <div class="card-base mon-panel p-5 md:p-7">
        <div class="mon-skeleton-line h-6 w-32"></div>
        <div class="mt-4 grid gap-3 md:grid-cols-2">
          <div class="mon-skeleton-block h-28"></div>
          <div class="mon-skeleton-block h-28"></div>
        </div>
      </div>
      <div class="card-base mon-panel p-5 md:p-7">
        <div class="mon-skeleton-block h-56"></div>
      </div>
    </section>

    <div id="mon-content" class="hidden space-y-4">
      <!-- 总览 -->
      <section class="card-base mon-panel p-5 md:p-7">
        <header class="flex flex-wrap items-start justify-between gap-4">
          <div class="min-w-0">
            <div class="flex items-center gap-2 text-xs font-bold text-[var(--btn-content)]">
              <Icon name="material-symbols:monitor-heart-outline-rounded" size="1.05rem" />
              监控总览
            </div>
            <h1 class="mt-2 text-2xl font-black text-[var(--mon-text-1)]">
              <span id="mon-greeting">服务器集群</span>
              <span id="mon-node-count" class="mon-accent"></span>
            </h1>
            <p id="mon-updated" class="mt-1 text-sm text-[var(--btn-content)]">正在连接监控面板…</p>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <span id="mon-state-pill" class="mon-pill mon-pill--pending">连接中</span>
            <button
              id="mon-autorefresh"
              type="button"
              class="btn-plain h-9 rounded-lg border border-[var(--line-color)] px-3 text-xs font-bold"
              aria-pressed="true"
              title="暂停 / 恢复自动刷新"
            >
              自动刷新
            </button>
            <button
              id="mon-refresh"
              type="button"
              class="btn-regular h-9 rounded-lg px-3 text-xs font-bold"
              title="立即刷新"
            >
              <Icon name="material-symbols:refresh-rounded" size="1rem" />
              <span class="ml-1">刷新</span>
            </button>
          </div>
        </header>
        <div id="mon-tiles" class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-6"></div>
      </section>

      <!-- 集群吞吐 -->
      <section class="card-base mon-panel p-5 md:p-7">
        <header class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2 text-xs font-bold text-[var(--btn-content)]">
            <Icon name="material-symbols:grouped-bar-chart-rounded" size="1.05rem" />
            集群实时吞吐
          </div>
          <div class="flex items-center gap-2">
            <span id="mon-total-rate" class="mon-big-number">—</span>
            <span class="text-xs font-bold text-[var(--btn-content)]">总带宽</span>
          </div>
        </header>

        <div class="mt-4 grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]">
          <div>
            <div class="flex items-end justify-between gap-2">
              <span class="text-3xl font-black text-[var(--mon-text-1)]" id="mon-online-rate">—</span>
              <span class="text-xs font-bold text-[var(--btn-content)]" id="mon-online-text">—</span>
            </div>
            <div class="mt-1 text-xs text-[var(--btn-content)]">节点在线率</div>
            <div id="mon-health-cells" class="mt-3 flex flex-wrap gap-1"></div>
            <div id="mon-legend" class="mt-4 space-y-1 text-xs text-[var(--btn-content)]"></div>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <div class="mon-chart-card">
              <div class="flex items-center justify-between">
                <span class="mon-chart-label">
                  <Icon name="material-symbols:upload-rounded" size="0.95rem" />
                  上行网络
                </span>
                <span id="mon-up-now" class="mon-chart-now">—</span>
              </div>
              <div id="mon-up-chart" class="mon-chart"></div>
            </div>
            <div class="mon-chart-card mon-chart-card--down">
              <div class="flex items-center justify-between">
                <span class="mon-chart-label">
                  <Icon name="material-symbols:download-rounded" size="0.95rem" />
                  下行网络
                </span>
                <span id="mon-down-now" class="mon-chart-now">—</span>
              </div>
              <div id="mon-down-chart" class="mon-chart"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- 节点矩阵 -->
      <section class="card-base mon-panel p-5 md:p-7">
        <header class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <div class="flex items-center gap-2 text-xs font-bold text-[var(--btn-content)]">
              <Icon name="material-symbols:deployed-code" size="1.05rem" />
              服务器矩阵
            </div>
            <h2 class="mt-1 text-lg font-black text-[var(--mon-text-1)]">节点负载与实时网络</h2>
          </div>
          <div id="mon-groups" class="flex flex-wrap gap-1 rounded-lg bg-[var(--btn-regular-bg)] p-1"></div>
        </header>
        <div id="mon-nodes" class="mt-5 grid gap-3 xl:grid-cols-2"></div>
      </section>
    </div>

    <p class="px-1 pb-2 text-xs text-[var(--btn-content)]">
      数据来自
      <a
        href={komariPanelUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="link-underline font-bold"
        >Komari</a
      >
      探针，经本站同源代理读取，每 5 秒更新一次。
    </p>
  </div>
</MainGridLayout>


<style is:global>
  /* 脚本注入的卡片没有 Astro 的 scoped 属性，这里统一用 #monitor-page 命名空间。 */
  #monitor-page {
    --mon-track: rgba(0, 0, 0, 0.09);
    --mon-line: rgba(0, 0, 0, 0.07);
    --mon-sunken: rgba(0, 0, 0, 0.03);
    --mon-chart-line: oklch(0.62 0.16 155);
    --mon-up: oklch(0.62 0.16 155);
    --mon-down: oklch(0.6 0.15 250);
    --mon-text-2: rgba(0, 0, 0, 0.55);
    --mon-text-1: rgba(0, 0, 0, 0.85);
  }
  :root.dark #monitor-page {
    --mon-track: rgba(255, 255, 255, 0.1);
    --mon-line: rgba(255, 255, 255, 0.07);
    --mon-sunken: rgba(255, 255, 255, 0.04);
    --mon-chart-line: oklch(0.72 0.16 155);
    --mon-up: oklch(0.72 0.16 155);
    --mon-down: oklch(0.7 0.14 250);
    --mon-text-2: rgba(255, 255, 255, 0.55);
    --mon-text-1: rgba(255, 255, 255, 0.88);
  }

  /* 面板本身不可点击，取消 .card-base 的悬浮位移 */
  #monitor-page .card-base:hover {
    transform: none;
    box-shadow: none;
  }

  #monitor-page .mon-accent {
    color: var(--primary);
  }
  #monitor-page .mon-big-number {
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  /* ---- 骨架 ---- */
  #monitor-page .mon-skeleton-line,
  #monitor-page .mon-skeleton-block {
    border-radius: 0.6rem;
    background: var(--mon-sunken);
    animation: mon-breathe 1.4s ease-in-out infinite;
  }
  #monitor-page .mon-skeleton-block {
    width: 100%;
  }
  @keyframes mon-breathe {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  /* ---- 状态胶囊 ---- */
  #monitor-page .mon-pill {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding: 0 0.75rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
    border: 1px solid var(--mon-line);
    background: var(--mon-sunken);
    color: var(--mon-text-2);
  }
  #monitor-page .mon-pill--ok {
    color: var(--mon-up);
    border-color: color-mix(in oklab, var(--mon-up) 35%, transparent);
    background: color-mix(in oklab, var(--mon-up) 12%, transparent);
  }
  #monitor-page .mon-pill--error {
    color: oklch(0.62 0.2 25);
    border-color: color-mix(in oklab, oklch(0.62 0.2 25) 35%, transparent);
    background: color-mix(in oklab, oklch(0.62 0.2 25) 12%, transparent);
  }

  /* ---- 总览格子 ---- */
  #monitor-page .mon-tile {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem 0.85rem;
    border-radius: 0.85rem;
    border: 1px solid var(--mon-line);
    background: var(--mon-sunken);
  }
  #monitor-page .mon-tile-head {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--mon-text-2);
  }
  #monitor-page .mon-tile-value {
    display: flex;
    align-items: baseline;
    gap: 0.2rem;
    font-size: 1.35rem;
    color: var(--mon-text-1);
  }
  #monitor-page .mon-tile-unit {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--mon-text-2);
  }
  #monitor-page .mon-tile-detail {
    font-size: 0.7rem;
    color: var(--mon-text-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---- 在线格 ---- */
  #monitor-page .mon-cell {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 0.28rem;
    background: var(--mon-up);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--mon-up) 45%, transparent);
  }
  #monitor-page .mon-cell--off {
    background: var(--mon-track);
    box-shadow: none;
  }
  #monitor-page .mon-legend-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  #monitor-page .mon-legend-row b {
    font-variant-numeric: tabular-nums;
    color: var(--mon-text-1);
  }

  /* ---- 图表 ---- */
  #monitor-page .mon-chart-card {
    --mon-plot-h: 5.25rem;
    padding: 0.7rem 0.8rem 0.6rem;
    border-radius: 0.85rem;
    border: 1px solid var(--mon-line);
    background: var(--mon-sunken);
  }
  #monitor-page .mon-chart-card--down {
    --mon-chart-line: var(--mon-down);
  }
  #monitor-page .mon-chart-label {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--mon-text-2);
  }
  #monitor-page .mon-chart-now {
    font-size: 0.78rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--mon-chart-line);
  }
  #monitor-page .mon-chart {
    margin-top: 0.4rem;
  }
  #monitor-page .mon-chart-plot {
    position: relative;
    height: calc(var(--mon-plot-h) + 2rem);
  }
  #monitor-page .mon-chart-peak {
    position: absolute;
    top: 0;
    left: 0;
    font-size: 0.62rem;
    font-variant-numeric: tabular-nums;
    color: var(--mon-text-2);
    pointer-events: none;
  }
  #monitor-page .mon-svg {
    position: absolute;
    top: 1.05rem;
    left: 0;
    right: 0;
    width: 100%;
    height: var(--mon-plot-h);
    overflow: visible;
  }
  #monitor-page .mon-grid-line {
    stroke: var(--mon-line);
  }
  #monitor-page .mon-chart-dot {
    fill: var(--mon-chart-line);
  }
  #monitor-page .mon-chart-time {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.1rem;
    display: flex;
    justify-content: space-between;
    font-size: 0.62rem;
    font-variant-numeric: tabular-nums;
    color: var(--mon-text-2);
    pointer-events: none;
  }

  /* ---- 分组切换 ---- */
  #monitor-page .mon-group-btn {
    height: 2rem;
    padding: 0 0.85rem;
    border-radius: 0.55rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--mon-text-2);
    transition: all 0.2s;
  }
  #monitor-page .mon-group-btn:hover {
    color: var(--mon-text-1);
  }
  #monitor-page .mon-group-btn.is-active {
    background: var(--card-bg);
    color: var(--primary);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.08);
  }

  /* ---- 节点卡 ---- */
  #monitor-page .mon-node {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.9rem 1rem 0.75rem;
    border-radius: 0.95rem;
    border: 1px solid var(--mon-line);
    background: var(--mon-sunken);
  }
  #monitor-page .mon-node--off {
    opacity: 0.62;
  }
  #monitor-page .mon-node-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  #monitor-page .mon-node-name {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1rem;
    font-weight: 800;
    color: var(--mon-text-1);
  }
  #monitor-page .mon-node-sub {
    margin-top: 0.1rem;
    font-size: 0.7rem;
    color: var(--mon-text-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  #monitor-page .mon-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    flex: none;
  }
  #monitor-page .mon-dot--on {
    background: var(--mon-up);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--mon-up) 22%, transparent);
    animation: mon-pulse 2.4s ease-in-out infinite;
  }
  #monitor-page .mon-dot--off {
    background: var(--mon-track);
  }
  @keyframes mon-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 3px color-mix(in oklab, var(--mon-up) 22%, transparent);
    }
    50% {
      box-shadow: 0 0 0 5px color-mix(in oklab, var(--mon-up) 10%, transparent);
    }
  }
  #monitor-page .mon-node-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    justify-content: flex-end;
  }
  #monitor-page .mon-tag {
    padding: 0.1rem 0.4rem;
    border-radius: 0.4rem;
    font-size: 0.65rem;
    font-weight: 700;
    border: 1px solid var(--mon-line);
    color: var(--mon-text-2);
    background: var(--card-bg);
  }

  #monitor-page .mon-node-metrics {
    display: grid;
    gap: 0.5rem;
  }
  #monitor-page .mon-metric-top {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--mon-text-2);
  }
  #monitor-page .mon-metric-value {
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--mon-text-1);
  }
  /* 分段 LED 进度条：用 mask 把实心条切成一格一格 */
  #monitor-page .mon-bar-track {
    position: relative;
    height: 0.5rem;
    margin-top: 0.2rem;
    border-radius: 0.3rem;
    background: var(--mon-track);
  }
  #monitor-page .mon-bar-fill {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 0.3rem;
    transition: width 0.45s ease, background 0.45s ease;
    -webkit-mask-image: repeating-linear-gradient(
      to right,
      #000 0 5px,
      transparent 5px 7.5px
    );
    mask-image: repeating-linear-gradient(to right, #000 0 5px, transparent 5px 7.5px);
  }
  #monitor-page .mon-metric-detail {
    margin-top: 0.1rem;
    font-size: 0.66rem;
    color: var(--mon-text-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #monitor-page .mon-node-rates {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  #monitor-page .mon-rate {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    padding: 0.4rem 0.6rem;
    border-radius: 0.6rem;
    border: 1px solid var(--mon-line);
    background: var(--card-bg);
  }
  #monitor-page .mon-rate-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--mon-text-2);
  }
  #monitor-page .mon-rate-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
  }
  #monitor-page .mon-rate-arrow--up {
    border-bottom: 6px solid var(--mon-up);
  }
  #monitor-page .mon-rate-arrow--down {
    border-top: 6px solid var(--mon-down);
  }
  #monitor-page .mon-rate-value {
    font-size: 0.9rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--mon-text-1);
  }
  #monitor-page .mon-rate-value i {
    margin-left: 0.15rem;
    font-size: 0.62rem;
    font-style: normal;
    font-weight: 700;
    color: var(--mon-text-2);
  }

  #monitor-page .mon-node-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--mon-line);
    font-size: 0.68rem;
    color: var(--mon-text-2);
  }
  #monitor-page .mon-node-time {
    margin-left: auto;
    font-weight: 700;
  }
  #monitor-page .mon-empty {
    padding: 2rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--mon-text-2);
  }
</style>
