---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";
import { formatDuration, formatWords, getYearReports } from "@utils/year-stats";
import { Icon } from "astro-icon/components";

const reports = await getYearReports();
const latest = reports[0];
const totalPosts = reports.reduce((sum, report) => sum + report.postCount, 0);
---

<MainGridLayout
	title="年度报告"
	description="把每一年写下的东西收成一份小结：写了多少、什么时候写、写在哪。"
>
	<div class="flex flex-col gap-4">
		<div class="card-base px-8 py-7">
			<div class="flex items-center gap-2">
				<Icon name="material-symbols:auto-awesome-outline-rounded" class="text-2xl text-[var(--primary)]" />
				<h1 class="text-2xl font-bold text-90">年度报告</h1>
			</div>
			<p class="mt-3 leading-relaxed text-75">
				这里把每一年写下的东西收成一份小结：写了多少、什么时候写、写在哪，以及那一年最特别的文章。
				目前一共 {reports.length} 个年份、{totalPosts} 篇。
			</p>
			{
				latest && (
					<a
						href={url(`/year/${latest.year}/`)}
						class="btn-regular mt-5 inline-flex h-9 items-center gap-1.5 px-4 text-sm"
					>
						看最近的一年：{latest.year}
						<Icon name="material-symbols:arrow-forward-rounded" />
					</a>
				)
			}
		</div>

		<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
			{
				reports.map((report) => (
					<a href={url(`/year/${report.year}/`)} class="card-base block px-6 py-5">
						<div class="flex items-center justify-between gap-3">
							<span class="bg-gradient-to-br from-[oklch(0.80_0.14_var(--hue))] to-[oklch(0.60_0.17_var(--hue))] bg-clip-text text-3xl font-bold text-transparent">
								{report.year}
							</span>
							<Icon name="material-symbols:arrow-forward-rounded" class="text-30" />
						</div>
						<div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-50">
							<span>{report.postCount} 篇</span>
							<span>{formatWords(report.words)}</span>
							<span>{formatDuration(report.minutes)}</span>
						</div>
						<div class="mt-3 flex flex-wrap gap-1.5">
							{report.topTags.slice(0, 4).map((tag) => (
								<span class="rounded-full bg-[var(--btn-regular-bg)] px-2.5 py-0.5 text-xs text-50">
									{tag.name}
								</span>
							))}
						</div>
					</a>
				))
			}
		</div>
	</div>
</MainGridLayout>
