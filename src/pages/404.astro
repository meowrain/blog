---
import SnakeGame from "@/components/game/SnakeGame.svelte";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout title="页面未找到" noCanonical>
		<div class="mx-auto flex w-full max-w-xl flex-col items-center px-1 pb-12 pt-2 text-center">
			<!-- 游戏要接管方向键，所以这张卡片别跟着鼠标上下浮 -->
			<div class="card-base w-full p-6 hover:!translate-y-0 hover:!shadow-none md:p-8">
				<!-- 404 图标 -->
				<div class="relative mb-1 select-none">
					<div class="text-7xl md:text-8xl font-bold leading-none text-[var(--primary)] opacity-20">
						404
					</div>
					<div class="absolute inset-0 flex items-center justify-center">
						<Icon name="fa6-solid:face-sad-tear" class="text-5xl md:text-6xl text-[var(--primary)]" />
					</div>
				</div>

				<!-- 错误信息 -->
				<h1 class="mb-3 text-2xl md:text-3xl font-bold text-90">页面走丢了</h1>
				<p class="mb-6 leading-relaxed text-75">
					这个地址下没有内容，可能是链接打错了，也可能是页面被搬走了。
					<br class="hidden sm:block" />
					反正都迷路了，先玩一局再决定去哪？
				</p>

				<SnakeGame client:load />

				<!-- 导航按钮 -->
				<div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
					<a href="/" class="btn-regular-dark px-6 py-3 rounded-lg text-white font-medium">
						<Icon name="fa6-solid:house" class="mr-2" />
						返回首页
					</a>
					<a href="/archive/" class="btn-regular px-6 py-3 rounded-lg font-medium">
						<Icon name="fa6-solid:box-archive" class="mr-2" />
						文章归档
					</a>
				</div>
			</div>

			<!-- 返回提示 -->
			<div class="mt-8 text-50 text-sm">
				<p class="flex items-center justify-center">
					<Icon name="fa6-solid:clock-rotate-left" class="mr-2" />
					您也可以使用浏览器的后退按钮返回上一页
				</p>
			</div>
		</div>
</MainGridLayout>