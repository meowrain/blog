---
import { statsConfig } from "@/config";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout
  title="访问统计"
  description="本站访问量、访客数与热门文章统计（自建，数据存于 EdgeOne Blob）"
>
  <div id="stats-page" class="space-y-4" data-stats-enabled={statsConfig.enable ? "true" : "false"}>
    {!statsConfig.enable && (
      <div class="card-base p-6">
        <p class="text-sm text-black/60 dark:text-white/60">
          统计功能已在 <code>src/config.ts</code> 的 <code>statsConfig.enable</code> 中关闭。
        </p>
      </div>
    )}

    {
      statsConfig.enable && (
        <>
          {/* 顶部：今日主数字 + 范围切换 */}
          <section class="card-base p-5 md:p-7">
            <header class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p class="text-sm text-black/50 dark:text-white/50">今日访问量</p>
                <div class="mt-1 flex items-baseline gap-2">
                  <span id="stats-hero" class="text-5xl font-bold leading-none text-black dark:text-white">
                    –
                  </span>
                  <span class="text-sm text-black/40 dark:text-white/40">次</span>
                </div>
                <p class="mt-2 text-xs text-black/40 dark:text-white/40">
                  今日访客 <span id="stats-hero-visitors" class="font-medium text-black/60 dark:text-white/60">–</span> 人
                </p>
              </div>
              <div class="flex items-center gap-1 rounded-lg border border-black/10 dark:border-white/10 p-1" role="group" aria-label="时间范围">
                <button type="button" data-range="7" class="stats-range-btn">7 天</button>
                <button type="button" data-range="30" class="stats-range-btn is-active">30 天</button>
                <button type="button" data-range="90" class="stats-range-btn">90 天</button>
              </div>
            </header>

            {/* 指标卡片 */}
            <div class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-6">
              <div class="stats-tile">
                <span class="stats-tile-label">区间访问量</span>
                <span id="tile-range-views" class="stats-tile-value">–</span>
              </div>
              <div class="stats-tile">
                <span class="stats-tile-label">区间访客数</span>
                <span id="tile-range-visitors" class="stats-tile-value">–</span>
              </div>
              <div class="stats-tile">
                <span class="stats-tile-label">日均访问量</span>
                <span id="tile-avg-views" class="stats-tile-value">–</span>
              </div>
              <div class="stats-tile">
                <span class="stats-tile-label">日均访客数</span>
                <span id="tile-avg-visitors" class="stats-tile-value">–</span>
              </div>
              <div class="stats-tile">
                <span class="stats-tile-label">人均页面数</span>
                <span id="tile-depth" class="stats-tile-value" title="区间访问量 ÷ 区间访客数">–</span>
              </div>
              <div class="stats-tile">
                <span class="stats-tile-label">最热时段</span>
                <span id="tile-busiest-hour" class="stats-tile-value stats-tile-time">–</span>
              </div>
              <div class="stats-tile">
                <span class="stats-tile-label">累计访问量</span>
                <span id="tile-site-views" class="stats-tile-value">–</span>
              </div>
              <div class="stats-tile">
                <span class="stats-tile-label">累计访客数</span>
                <span id="tile-site-visitors" class="stats-tile-value">–</span>
              </div>
              <div class="stats-tile">
                <span class="stats-tile-label">有访问的页面</span>
                <span id="tile-pages" class="stats-tile-value">–</span>
              </div>
              <div class="stats-tile">
                <span class="stats-tile-label">峰值日访问量</span>
                <span id="tile-peak" class="stats-tile-value">–</span>
              </div>
              <div class="stats-tile">
                <span class="stats-tile-label">有数据天数</span>
                <span id="tile-days-with-data" class="stats-tile-value">–</span>
              </div>
              <div class="stats-tile">
                <span class="stats-tile-label">更新于</span>
                <span id="tile-updated" class="stats-tile-value stats-tile-time">–</span>
              </div>
            </div>
          </section>

          {/* 趋势图 */}
          <section class="card-base p-5 md:p-7">
            <header class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="text-base font-bold text-black dark:text-white">访问趋势</h2>
              <div id="stats-legend" class="flex items-center gap-4 text-xs text-black/60 dark:text-white/60">
                <span class="flex items-center gap-1.5">
                  <span class="stats-swatch stats-swatch-views"></span>访问量
                </span>
                <span class="flex items-center gap-1.5">
                  <span class="stats-swatch stats-swatch-visitors"></span>访客数
                </span>
              </div>
            </header>
            <div id="stats-chart" class="stats-chart relative mt-4">
              <p class="stats-empty">加载中…</p>
              {/* tooltip 必须放在图表容器内部：容器才是定位参照，放外面会被
                  card-base 的 overflow-hidden 裁掉 */}
              <div id="stats-tooltip" class="stats-tooltip" hidden></div>
            </div>
          </section>

          {/* 时段分布 + 一周分布 */}
          <div class="grid gap-4 xl:grid-cols-2">
            <section class="card-base p-5 md:p-7">
              <header class="flex flex-wrap items-center justify-between gap-2">
                <h2 class="text-base font-bold text-black dark:text-white">时段分布</h2>
                <span class="text-xs text-black/40 dark:text-white/40">按上海时区，区间内累计</span>
              </header>
              <div id="stats-hours" class="stats-chart stats-chart-bars relative mt-3">
                <p class="stats-empty">加载中…</p>
                <div id="stats-hours-tooltip" class="stats-tooltip" hidden></div>
              </div>
            </section>

            <section class="card-base p-5 md:p-7">
              <header class="flex flex-wrap items-center justify-between gap-2">
                <h2 class="text-base font-bold text-black dark:text-white">一周分布</h2>
                <span class="text-xs text-black/40 dark:text-white/40">按周几汇总，含日均</span>
              </header>
              <div class="mt-3 overflow-x-auto">
                <table class="stats-table">
                  <thead>
                    <tr>
                      <th>星期</th>
                      <th class="stats-th-num">访问量</th>
                      <th class="stats-th-num">访客数</th>
                      <th class="stats-th-num">日均</th>
                      <th class="stats-th-share">占比</th>
                    </tr>
                  </thead>
                  <tbody id="stats-weekdays">
                    <tr><td colspan="5" class="stats-table-empty">加载中…</td></tr>
                  </tbody>
                </table>
              </div>
            </section>
          </div>

          {/* 受众结构 */}
          <section class="card-base p-5 md:p-7">
            <header class="flex flex-wrap items-center justify-between gap-2">
              <h2 class="text-base font-bold text-black dark:text-white">受众结构</h2>
              <span class="text-xs text-black/40 dark:text-white/40">
                新访客 = 全站首次出现；回访 = 其余。访客按天去重，跨天可能重复统计
              </span>
            </header>
            <div id="stats-audience" class="mt-4">
              <div class="stats-split">
                <div id="stats-audience-new" class="stats-split-seg stats-split-new" style="width: 0%"></div>
                <div id="stats-audience-returning" class="stats-split-seg stats-split-returning" style="width: 0%"></div>
              </div>
              <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-4">
                <div class="stats-tile">
                  <span class="stats-tile-label">
                    <span class="stats-swatch stats-swatch-new"></span> 新访客
                  </span>
                  <span class="stats-tile-value">
                    <span id="audience-new">–</span>
                    <span id="audience-new-pct" class="stats-tile-sub">0%</span>
                  </span>
                </div>
                <div class="stats-tile">
                  <span class="stats-tile-label">
                    <span class="stats-swatch stats-swatch-returning"></span> 回访访客
                  </span>
                  <span class="stats-tile-value">
                    <span id="audience-returning">–</span>
                    <span id="audience-returning-pct" class="stats-tile-sub">0%</span>
                  </span>
                </div>
                <div class="stats-tile">
                  <span class="stats-tile-label">区间访客数</span>
                  <span id="audience-total" class="stats-tile-value">–</span>
                </div>
                <div class="stats-tile">
                  <span class="stats-tile-label">人均页面数</span>
                  <span id="audience-depth" class="stats-tile-value">–</span>
                </div>
              </div>
            </div>
          </section>

          {/* 维度排行：来源 / 设备 / 浏览器 / 系统 / 国家 / 地区 */}
          <section class="card-base p-5 md:p-7">
            <header class="flex flex-wrap items-center justify-between gap-2">
              <h2 class="text-base font-bold text-black dark:text-white">来源与终端</h2>
              <span id="stats-dimension-note" class="text-xs text-black/40 dark:text-white/40">
                维度从上线后开始采集，历史数据不含此项
              </span>
            </header>
            <div class="mt-4 grid gap-x-6 gap-y-5 md:grid-cols-2">
              <div>
                <h3 class="stats-subtitle">来源渠道</h3>
                <table class="stats-table">
                  <thead>
                    <tr>
                      <th>来源</th>
                      <th class="stats-th-num">访问量</th>
                      <th class="stats-th-num">占比</th>
                      <th class="stats-th-share"></th>
                    </tr>
                  </thead>
                  <tbody id="stats-dim-referrers">
                    <tr><td colspan="4" class="stats-table-empty">加载中…</td></tr>
                  </tbody>
                </table>
              </div>
              <div>
                <h3 class="stats-subtitle">设备类型</h3>
                <table class="stats-table">
                  <thead>
                    <tr>
                      <th>设备</th>
                      <th class="stats-th-num">访问量</th>
                      <th class="stats-th-num">占比</th>
                      <th class="stats-th-share"></th>
                    </tr>
                  </thead>
                  <tbody id="stats-dim-devices">
                    <tr><td colspan="4" class="stats-table-empty">加载中…</td></tr>
                  </tbody>
                </table>
              </div>
              <div>
                <h3 class="stats-subtitle">浏览器</h3>
                <table class="stats-table">
                  <thead>
                    <tr>
                      <th>浏览器</th>
                      <th class="stats-th-num">访问量</th>
                      <th class="stats-th-num">占比</th>
                      <th class="stats-th-share"></th>
                    </tr>
                  </thead>
                  <tbody id="stats-dim-browsers">
                    <tr><td colspan="4" class="stats-table-empty">加载中…</td></tr>
                  </tbody>
                </table>
              </div>
              <div>
                <h3 class="stats-subtitle">操作系统</h3>
                <table class="stats-table">
                  <thead>
                    <tr>
                      <th>系统</th>
                      <th class="stats-th-num">访问量</th>
                      <th class="stats-th-num">占比</th>
                      <th class="stats-th-share"></th>
                    </tr>
                  </thead>
                  <tbody id="stats-dim-oses">
                    <tr><td colspan="4" class="stats-table-empty">加载中…</td></tr>
                  </tbody>
                </table>
              </div>
              <div>
                <h3 class="stats-subtitle">国家 / 地区</h3>
                <table class="stats-table">
                  <thead>
                    <tr>
                      <th>国家</th>
                      <th class="stats-th-num">访问量</th>
                      <th class="stats-th-num">占比</th>
                      <th class="stats-th-share"></th>
                    </tr>
                  </thead>
                  <tbody id="stats-dim-countries">
                    <tr><td colspan="4" class="stats-table-empty">加载中…</td></tr>
                  </tbody>
                </table>
              </div>
              <div>
                <h3 class="stats-subtitle">省份 / 区域</h3>
                <table class="stats-table">
                  <thead>
                    <tr>
                      <th>区域</th>
                      <th class="stats-th-num">访问量</th>
                      <th class="stats-th-num">占比</th>
                      <th class="stats-th-share"></th>
                    </tr>
                  </thead>
                  <tbody id="stats-dim-regions">
                    <tr><td colspan="4" class="stats-table-empty">加载中…</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          {/* 热门文章 + 最近活跃 */}
          <div class="grid gap-4 xl:grid-cols-2">
            <section class="card-base p-5 md:p-7">
              <h2 class="text-base font-bold text-black dark:text-white">热门页面</h2>
              <p class="mt-1 text-xs text-black/40 dark:text-white/40">按累计访问量排序，取前 12 个</p>
              <div class="mt-3 overflow-x-auto">
                <table class="stats-table">
                  <thead>
                    <tr>
                      <th class="stats-th-index">#</th>
                      <th class="stats-title">页面</th>
                      <th class="stats-th-num">访问量</th>
                      <th class="stats-th-num">访客数</th>
                    </tr>
                  </thead>
                  <tbody id="stats-top-pages">
                    <tr><td colspan="4" class="stats-table-empty">加载中…</td></tr>
                  </tbody>
                </table>
              </div>
            </section>

            <section class="card-base p-5 md:p-7">
              <h2 class="text-base font-bold text-black dark:text-white">最近活跃</h2>
              <p class="mt-1 text-xs text-black/40 dark:text-white/40">按最后一次被访问的时间排序</p>
              <div class="mt-3 overflow-x-auto">
                <table class="stats-table">
                  <thead>
                    <tr>
                      <th class="stats-title">页面</th>
                      <th class="stats-th-num">访问量</th>
                      <th class="stats-th-num">最近访问</th>
                    </tr>
                  </thead>
                  <tbody id="stats-recent-pages">
                    <tr><td colspan="3" class="stats-table-empty">加载中…</td></tr>
                  </tbody>
                </table>
              </div>
            </section>
          </div>

          <p id="stats-error" class="hidden rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-600 dark:text-red-400"></p>
        </>
      )
    }
  </div>
</MainGridLayout>

<style is:global>
    #stats-page {
      /* 配色（dataviz validate_palette.js 校验通过）：
         蓝=访问量、橙=访客数；青=新访客、紫=回访访客（对比度 WARN 已由
         可见数值标签 + 表格视图兜底）。深色态是同色相的深色步进，不是简单反色。 */
      --viz-views: #2a78d6;
      --viz-visitors: #eb6834;
      --viz-new: #1baf7a;
      --viz-returning: #6250d6;
      --viz-grid: rgba(0, 0, 0, 0.08);
      --viz-axis-text: rgba(0, 0, 0, 0.45);
      --viz-surface: #fcfcfb;
    }
    /* 深色态统一用 .dark 类判断：<html data-theme> 存的是 expressive-code 的
       主题名（github-dark），拿它当明暗开关永远匹配不上，导致这一页在深色下
       仍然套浅色文字。 */
    :root.dark #stats-page {
      --viz-views: #3987e5;
      --viz-visitors: #d95926;
      --viz-new: #199e70;
      --viz-returning: #9085e9;
      --viz-grid: rgba(255, 255, 255, 0.12);
      --viz-axis-text: rgba(255, 255, 255, 0.5);
      --viz-surface: #1a1a19;
    }

    .stats-range-btn {
      border-radius: 0.375rem;
      padding: 0.25rem 0.6rem;
      font-size: 0.75rem;
      font-weight: 500;
      color: rgba(0, 0, 0, 0.55);
      transition: background-color 0.15s, color 0.15s;
    }
    :root.dark .stats-range-btn {
      color: rgba(255, 255, 255, 0.6);
    }
    .stats-range-btn:hover {
      background: var(--btn-plain-bg-hover, rgba(0, 0, 0, 0.05));
    }
    .stats-range-btn.is-active {
      background: var(--primary);
      color: #fff;
    }

    .stats-tile {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      padding: 0.75rem 0.85rem;
      border-radius: 0.6rem;
      border: 1px solid rgba(0, 0, 0, 0.08);
    }
    :root.dark .stats-tile {
      border-color: rgba(255, 255, 255, 0.1);
    }
    .stats-tile-label {
      font-size: 0.72rem;
      color: rgba(0, 0, 0, 0.5);
    }
    :root.dark .stats-tile-label {
      color: rgba(255, 255, 255, 0.55);
    }
    .stats-tile-value {
      font-size: 1.35rem;
      font-weight: 700;
      line-height: 1.1;
      color: #111;
    }
    :root.dark .stats-tile-value {
      color: #f0efec;
    }
    .stats-tile-time {
      font-size: 0.8rem;
      font-weight: 500;
      color: rgba(0, 0, 0, 0.5);
    }
    :root.dark .stats-tile-time {
      color: rgba(255, 255, 255, 0.5);
    }
    /* 副数字（如 12 <small>30%</small>）：不抢主数字，文字仍用次级墨色 */
    .stats-tile-sub {
      font-size: 0.75rem;
      font-weight: 500;
      color: rgba(0, 0, 0, 0.45);
    }
    :root.dark .stats-tile-sub {
      color: rgba(255, 255, 255, 0.5);
    }

    .stats-subtitle {
      margin-bottom: 0.5rem;
      font-size: 0.8rem;
      font-weight: 600;
      color: rgba(0, 0, 0, 0.6);
    }
    :root.dark .stats-subtitle {
      color: rgba(255, 255, 255, 0.65);
    }

    /* 新老访客占比条：2px 表面色缝隙分隔两段，不靠颜色单打独斗 */
    .stats-split {
      display: flex;
      gap: 2px;
      height: 0.6rem;
      border-radius: 999px;
      overflow: hidden;
      background: rgba(0, 0, 0, 0.06);
    }
    :root.dark .stats-split {
      background: rgba(255, 255, 255, 0.08);
    }
    .stats-split-seg {
      height: 100%;
      transition: width 0.3s ease;
    }
    .stats-split-new {
      background: var(--viz-new);
    }
    .stats-split-returning {
      background: var(--viz-returning);
    }

    /* 表格里的迷你占比条：中性色（不是系列色），只表达长度 */
    .stats-share {
      width: 4.5rem;
    }
    .stats-bar-track {
      position: relative;
      height: 0.35rem;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.07);
      overflow: hidden;
    }
    :root.dark .stats-bar-track {
      background: rgba(255, 255, 255, 0.1);
    }
    .stats-bar-fill {
      height: 100%;
      border-radius: 999px;
      background: var(--viz-views);
    }

    .stats-swatch {
      display: inline-block;
      width: 0.7rem;
      height: 0.7rem;
      border-radius: 2px;
      vertical-align: middle;
    }
    .stats-tile-label .stats-swatch {
      margin-right: 0.3rem;
    }
    .stats-swatch-views {
      background: var(--viz-views);
    }
    .stats-swatch-visitors {
      background: var(--viz-visitors);
    }
    .stats-swatch-new {
      background: var(--viz-new);
    }
    .stats-swatch-returning {
      background: var(--viz-returning);
    }

    .stats-chart {
      width: 100%;
      min-height: 260px;
    }
    .stats-chart-bars {
      min-height: 190px;
    }
    .stats-chart svg {
      display: block;
      width: 100%;
      height: auto;
    }
    .stats-empty {
      padding: 3rem 0;
      text-align: center;
      font-size: 0.85rem;
      color: rgba(0, 0, 0, 0.4);
    }
    :root.dark .stats-empty {
      color: rgba(255, 255, 255, 0.4);
    }

    .stats-tooltip {
      position: absolute;
      z-index: 20;
      pointer-events: none;
      transform: translate(-50%, -100%);
      border-radius: 0.5rem;
      border: 1px solid rgba(0, 0, 0, 0.1);
      background: #fff;
      padding: 0.4rem 0.55rem;
      font-size: 0.72rem;
      line-height: 1.35;
      white-space: nowrap;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
      color: #111;
    }
    /* 顶部空间不足时翻到折线下方，锚点改为左上角 */
    .stats-tooltip.is-below {
      transform: translate(-50%, 0);
    }
    :root.dark .stats-tooltip {
      border-color: rgba(255, 255, 255, 0.14);
      background: #262624;
      color: #f0efec;
    }
    .stats-tooltip-row {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .stats-tooltip-dot {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
    }

    .stats-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.82rem;
    }
    .stats-table th {
      text-align: left;
      font-weight: 600;
      /* 表头不折行：「星期」「访问量」这类短词被挤成竖排很难读 */
      white-space: nowrap;
      color: rgba(0, 0, 0, 0.5);
      padding: 0.4rem 0.5rem;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }
    :root.dark .stats-table th {
      color: rgba(255, 255, 255, 0.55);
      border-bottom-color: rgba(255, 255, 255, 0.1);
    }
    .stats-table td {
      padding: 0.45rem 0.5rem;
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }
    :root.dark .stats-table td {
      border-bottom-color: rgba(255, 255, 255, 0.06);
    }
    .stats-th-index,
    .stats-th-num {
